                </div>
            </div>
        </div>
    </div>
) : (
    /* 保留此元素以确保Swup正常工作（float 模式 / 未启用目录 / 本页无标题时占位） */
    <div id="toc-container" class="hidden"></div>
)}
</div>
</Layout>
{/* 26.08.30修改，内容为：新增简洁模式与非首页时隐藏左右磁贴、主内容占满整行的样式 */}


<style define:vars={{
    'page-fade-out': `${siteConfig.pageTransition.fadeOut}ms`,
    'page-fade-in': `${siteConfig.pageTransition.fadeIn}ms`,
}}>
/* 26.09.14：渐变动画时长（唯一来源 siteConfig.pageTransition）——只在此处写一次，
   src/styles/transition.css 的过渡/动画时长全部读这两个变量，改 config 即同步生效。
   ⚠ 不要在这里或 transition.css 里写死毫秒值（下面的 :root 兜底值只为「模块尚未执行」时仍有值）。
   ⚠ 变量落在 :root（继承属性）⇒ 任何位置的选择器都能读到，也是 transition.css（全局样式表）
      与 Layout.astro 首帧内联样式共用的前提。
   ⚠ Astro 对含 define:vars 的样式会把变量写到「该选择器自身」，所以选择器必须是 :root，
      而且规则里不能再引用同名变量（自引用会解析失败）。 */
:root {
    --page-fade-out: 200ms;
    --page-fade-in: 250ms;
}

:global(.sidebar-force-hidden) {
    display: none !important;
}

/* 26.09.14：导航栏常驻吸顶（fixed）+ 等高占位块。
   #top-row 已由 Layout.astro 给出 --top-row-h（banner 模式跟随横幅高度，其余模式 3.6rem）；
   这里把同一变量写给占位块，保证「脱离文档流」与「补回空间」严格等值 ⇒ 首屏排版零变化。
   ⚠ 若将来再调 --top-row-h 的取值，占位块无需改动（同源变量）。 */
:global(#top-row-space) {
    height: var(--top-row-h, 3.6rem);
}

/* 导航栏在任何页面/壁纸模式下都不许被隐藏或移出视口：
   全站禁用 .navbar-hidden（历史遗留的滚动隐藏类），并把可能影响 fixed 定位的
   transform/opacity 复位，避免父级动画把吸顶条一起带走。 */
:global(.navbar-hidden) {
    opacity: 1 !important;
    transform: none !important;
}
:global(#top-row) {
    position: fixed !important;
    top: 0 !important;
    opacity: 1 !important;
    transform: none !important;
}

/* 26.09.15：导航栏「悬挂」（吸顶）开关 —— siteConfig.navbar.pinned
   · true（默认）：#top-row 固定悬挂在视口顶部，下拉时始终可见（原行为，本段不生效）；
   · false：#top-row 回到文档流（position:static），导航栏随页面一起滚走、不再悬挂；
     紧随其后的等高占位块 #top-row-space 同步取消，否则会多出一段空白。 */
:global(#top-row[data-navbar-pinned="false"]) {
    position: static !important;
    top: auto !important;
}

:global(#top-row[data-navbar-pinned="false"] + #top-row-space) {
    display: none !important;
}

/* 切页期间导航栏同样常驻：#main-grid 淡出/预渲染/淡入时，#top-row 保持可见不被牵连
   （对应 Layout.astro 注释中「#top-row/#navbar-wrapper 顶部工具栏保留，站点骨架不淡出」）。 */
:global(body.swup-leaving) #top-row,
:global(body.page-entering) #top-row,
:global(body.page-prerender) #top-row {
    opacity: 1 !important;
    animation: none !important;
    pointer-events: none;
}

:global(body.swup-leaving) #top-row #navbar-wrapper,
:global(body.page-entering) #top-row #navbar-wrapper,
:global(body.page-prerender) #top-row #navbar-wrapper {
    opacity: 1 !important;
    animation: none !important;
    pointer-events: auto;
}

/* 非主页：隐藏左右磁贴（覆盖初始加载时 SideBar 内部样式，以及 swup 切换后的旧状态） */
:global(body:not(.lg\:is-home) .home-sidebar),
:global(body:not(.lg\:is-home) .home-right-sidebar) {
    display: none !important;
}

/* 26.09.14：导航栏与主卡片重合时的下边界描边。
   需求：下拉后导航栏与主卡片（文章卡片/友链卡片/图片卡片…）宽度常常相同，需要可视区分；
   只在「被压住的那段卡片宽度」上、于导航栏下边界画一条主题色横线，带阴影，随重合淡入淡出。
   ⚠ 刻意不做圆角：观感要接近一条横线，而不是圆角矩形的下边线。 */
:global(#navbar-card-separator) {
    position: fixed;
    left: 0;
    top: 0;
    width: 0;
    height: 1px;
    border-radius: 0;
    /* 降低线宽与透明度：1px 细线 + 主题色 55% 透明度。
       阴影用 drop-shadow（跟着实际画的像素走），这样多段线之间的空隙不会拖出阴影。 */
    background: color-mix(in oklab, var(--primary) 55%, transparent);
    filter: drop-shadow(0 1px 3px color-mix(in oklab, var(--primary) 30%, transparent));
    opacity: 0;
    pointer-events: none;
    z-index: 60;
    transition: opacity 260ms ease;
}

:global(#navbar-card-separator.is-visible) {
    opacity: 1;
}

/* 非主页：主内容区占满整行，与上方导航栏等宽居中（覆盖 swup 切换后残留的旧网格列模板） */
@media (min-width: 768px) {
    :global(body:not(.lg\:is-home) #main-grid) {
