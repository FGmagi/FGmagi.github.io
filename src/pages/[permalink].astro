---
import type { CollectionEntry } from "astro:content";
import PostView from "../components/posts/PostView.astro";
import { permalinkConfig } from "../config";
import { getSortedPosts } from "../utils/content-utils";
import {
	generatePermalinkSlug,
	hasCustomPermalink,
	initPostIdMap,
} from "../utils/permalink-utils";

type PathProps = { entry: CollectionEntry<"posts"> };

export async function getStaticPaths() {
	const entries = await getSortedPosts();
	initPostIdMap(entries);
	const paths: Array<{ params: { permalink: string }; props: PathProps }> = [];
	for (const entry of entries) {
		const permalink = hasCustomPermalink(entry)
			? entry.data.permalink!.replace(/^\/+|\/+$/g, "")
			: permalinkConfig.enable
				? generatePermalinkSlug(entry)
				: "";
		if (permalink) {
			paths.push({ params: { permalink }, props: { entry } });
		}
	}
	return paths;
}

const { entry } = Astro.props as PathProps;
---

<PostView entry={entry} />
