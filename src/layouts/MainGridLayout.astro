/* 当没有 banner 时，主内容区域移到顶部 */
body.no-banner-mode .absolute.w-full.z-30 {
    top: 5.5rem !important;
}

/* TOC 垂直对齐优化（26.09.06：几何改由 toc-layout.js 写入 --toc-top/--toc-max-h，
   两种模式（banner / no-banner）统一读同一组变量，不再各自硬编码 max-height）。
   这里给出无 JS / 未重算时的兜底值（不依赖 Tailwind 任意值解析）。 */
#toc-inner-wrapper {
    top: var(--toc-top, 3.5rem);
    max-height: var(--toc-max-h, calc(100vh - 10rem));
    overflow: hidden;
    /* 26.09.06：目录卡片在「文章卡片右边缘 → 视口右边缘」的右侧余量内居中。
       余量 R = --toc-width + --article-gutter，卡宽 T = --toc-card-width，
       居中 ⇒ 右侧空隙 = (R − T) / 2；max() 第二分支是距视口右 1rem 的硬性下限。
       横向定位只此一处：#toc-wrapper（absolute）已不再持有任何 right 规则，
       避免两套定位规则并存。 */
    right: max(
        calc((var(--toc-width) + var(--article-gutter) - var(--toc-card-width)) / 2),
        var(--toc-edge-gap, 1rem)
    );
}

body.no-banner-mode #toc-inner-wrapper {
    top: var(--toc-top, 5.5rem) !important;
    max-height: var(--toc-max-h, calc(100vh - 8rem)) !important;
}

/* 26.09.14：侧栏目录轨道「始终渲染、只切换可见性」。
   要求（用户）：目录要提前渲染好/缓存起来，切宽窄时直接动画收放，不再 display:none 后重新排版。
   做法：有轨道的文章页恒 display:block（排版常驻），默认 visibility:hidden + opacity:0；
   只有 toc-layout.js 判定 desktop 时才可见（JS 之前的首帧也不会闪）。
   narrow 时由 toc-layout.js 播「收进导航栏按钮」动画，动画期间用内联 visibility 临时可见，
   结束后交还给 CSS。 */
:global(#toc-rail-wrapper[data-toc-present="true"]) {
    display: block;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
}

:global(html[data-toc-layout="desktop"]) #toc-rail-wrapper[data-toc-present="true"] {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
}

/* JS 尚未判定（无 data-toc-layout）但视口足够宽时也先显示：
   swup 换页那一下 #toc-swup-region 是同步替换的，属性可能还停留在上一页的取值，
   这时必须按结构（data-toc-present）+ 宽度兜住，保证目录在预渲染帧里就位。 */
@media (min-width: 1280px) {
    :global(html:not([data-toc-layout="narrow"])) #toc-rail-wrapper[data-toc-present="true"] {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
    }
}

/* 26.09.14：预渲染帧内目录 rail 必须「已经在位」。
   问题（用户报告：从其它页面跳转文章页时 toc 没有进入预渲染）：
   `html[data-toc-layout]` 是 toc-layout.js 的**客户端**判定结果，而 swup 换页是同步替换
   #toc-swup-region —— 预渲染帧里 rail 刚被换成新节点，属性却还可能停留在「上一页」的取值
   （从首页/列表页进入时是 narrow 或干脆没有），于是 rail 在预渲染帧里 display:none，
   下一帧才被重算点亮 ⇒ 目录在渐变结束后才「跳」出来，与文章卡片不同步。
   这里补一条不依赖任何 JS 时序的可见性来源：结构数据（data-toc-layout）或
   节点自身的 data-toc-present（SSR 只在本页确实渲染了 rail 时输出）任一满足即显示。
   ⚠ 必须用 min-width 媒体查询兜住：媒体查询里的 rem 恒按初始 16px 解析，
     88rem = 1408px，正好是「解析期脚本置位 desktop」与「JS 判 narrow」之间的分界带
     （详见下方解析期脚本的长注释）。1280px 档位（= MOBILE_ENTRY_MAX / lg 断点）与
     toc-layout.js 的 MOBILE_ENTRY_MAX 同源，不会出现「CSS 判定显示、JS 判定窄屏」的闪烁。 */
/* 全屏壁纸模式下的 TOC 毛玻璃背景 - 仅在 TOC 加载完成后显示
   （--toc-inner-pad 供 table-of-contents 的 max-height 扣掉卡片内边距，
     否则最后一个条目的文字/图标会溢出卡片下边缘） */
body.wallpaper-transparent #toc-inner-wrapper:has(table-of-contents[data-loaded="true"]) {
    background: var(--card-bg-transparent) !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
    border-radius: var(--radius-large);
    padding: 0.5rem;
    --toc-inner-pad: 0.5rem;
    box-shadow: var(--shadow-lg);
}

