---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";
import { getSortedPostsList } from "@utils/content-utils";
import fs from "node:fs";
import path from "node:path";

// 26.09.02 [11]修改，内容为：取消全站分类展示——停止对文章 category 的 null 兼容转换与 categories 列表提取，ArchivePanel 不再接收/筛选分类；文章数据、标签提取与正文搜索映射保持不变
const sortedPostsList = await getSortedPostsList();

// 26.09.02 [10、H-01]：getSortedPostsList 已在数据源过滤 active:false，删除原 26.08.30 归档页重复过滤
const posts = sortedPostsList;

// 提取所有标签 (去重)
const tags = [...new Set(posts.flatMap(post => post.data.tags))];

// 26.08.30/26.09.02 [10、H-01]修改，内容为：构建文章正文内容映射（id -> 原始 md 文本），供归档页关键字搜索使用；与归档列表一致仅保留 active 文章
const rawPosts = await getCollection("posts", ({ data }) => {
	const draftOk = import.meta.env.PROD ? data.draft !== true : true;
	return draftOk && data.active !== false;
});
const postsContent: Record<string, string> = {};
for (const rawPost of rawPosts) {
	// 26.08.30修改，内容为：glob loader 条目无 body，按 filePath 读取原始 md 文本
	if (rawPost.filePath) {
		postsContent[rawPost.id] = fs.readFileSync(
			path.join(process.cwd(), rawPost.filePath),
			"utf-8",
		);
	}
}
---

<MainGridLayout title={i18n(I18nKey.archive)}>
    <!-- 引入右侧边栏布局管理器 -->
    <script>
        import('../scripts/right-sidebar-layout.js');
    </script>

    <!-- 修复：补全缺失的 tags 属性 -->
    <ArchivePanel
            sortedPosts={posts}
            tags={tags}
            postsContent={postsContent}
            client:only="svelte"
    ></ArchivePanel>
</MainGridLayout>
