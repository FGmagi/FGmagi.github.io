---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "eager" | "lazy";
	// 26.08.31修改，内容为：新增 hideOverlay 属性，用于隐藏默认的半透明暗色遮罩层（封面透明边距需要）
	hideOverlay?: boolean;
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const { id, src, alt, position = "center", basePath = "/", loading = "lazy", hideOverlay = false } = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// 26.08.30修改，内容为：修复 content 集合移至 public/data 后，public 目录下的本地图片无法通过 import.meta.glob 渲染的问题（glob 只匹配 src/ 内文件），找不到时回退为 public URL 渲染
// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img: ImageMetadata | undefined;
let publicImagePath = "";
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		// public/ 目录下的图片（如 /data/posts/xxx/image/cover.jpg）不会被 glob 匹配，
		// 但构建时会原样复制到 dist，直接构造 public URL 即可
		if (basePath.startsWith("public/")) {
			publicImagePath = url(
				`/${basePath.replace(/^public\//, "")}/${src.replace(/^\.\//, "")}`,
			);
		} else {
			console.error(
				`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
			);
		}
	} else {
		img = await file();
	}
}

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;

// 检查是否是 Bilibili 图片
const isBilibiliImage = !isLocal && src.includes("hdslb.com");
// 对于外部图片（特别是Bilibili），需要设置referrerpolicy避免403错误
const referrerPolicy = !isLocal && isBilibiliImage ? "no-referrer" : undefined;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    {!hideOverlay && (
        <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    )}
    {isLocal && img && <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading}/>}
    {isLocal && !img && publicImagePath && <img src={publicImagePath} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading}/>}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading} referrerpolicy={referrerPolicy} crossorigin={isBilibiliImage ? "anonymous" : undefined}/>}
</div>
