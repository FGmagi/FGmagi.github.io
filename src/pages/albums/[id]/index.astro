---
import { siteConfig } from "../../../config";
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import MainGridLayout from "../../../layouts/MainGridLayout.astro";
// import type { GetStaticPaths } from "astro";
import type { AlbumGroup, Photo } from "../../../types/album";
import { scanAlbums } from "../../../utils/album-scanner";
import { enrichAlbums } from "../../../utils/photo-meta";
import { photoKey } from "../../../utils/photo-identity";

// 检查相册页面是否启用
if (!siteConfig.featurePages.albums) {
	return Astro.redirect("/404/");
}

export const getStaticPaths = async () => {
	const albumsData = await scanAlbums();
	// 26.09.06 尺寸决策四级（①显式 ②build memo ③本地原档 sharp ④未知交运行期）：
	// enrichAlbums 就地回填 photo.width/height（只发生在 build/SSR，零运行时开销）
	const enriched = await enrichAlbums(albumsData);
	return enriched.map((album) => ({
		params: { id: album.id },
		props: { album },
	}));
};

interface Props {
	album: AlbumGroup;
}

const { album } = Astro.props;

if (!album) {
	return Astro.redirect("/404/");
}

// 26.09.06 注入双通道之一：SSR 内联尺寸。
// - masonry：已知尺寸写 figure 内联 aspect-ratio + img width/height、data-key、data-dim；
//   未知项无 data-dim + 类 photo-dim-unknown（交运行期探测/默认占位）；
// - grid：CSS 1:1 裁剪、不注入 aspect-ratio（仍带 data-key/data-dim 供纠正与缓存）。
const galleryItems = album.photos.map((photo: Photo, index: number) => {
	const dimKnown =
		typeof photo.width === "number" &&
		typeof photo.height === "number" &&
		photo.width > 0 &&
		photo.height > 0;
	const key = photoKey(album.id, photo.src);
	return {
		photo,
		index,
		key,
		dimKnown,
		aspectStyle:
			dimKnown && album.layout === "masonry"
				? `aspect-ratio: ${photo.width} / ${photo.height};`
				: undefined,
	};
});

// 26.09.21：超宽横图跨列（方案 B：CSS Grid + 行跨）参数下发。
// 只在「masonry 相册 + 总开关打开」时下发 data-* 参数；运行期脚本
// （utils/photo-masonry-grid.ts）读到才接管排版，否则直接退出，
// 页面保持原来的 CSS 多列瀑布流（无 JS 也照旧可读）。
const spanConfig = siteConfig.albumsMasonrySpan;
const spanMax = Math.min(2, Math.max(1, Math.round(spanConfig?.maxSpan ?? 1)));
const spanActive =
	!!spanConfig?.enable &&
	album.layout === "masonry" &&
	spanMax >= 2 &&
	album.photos.length > 1;
const spanMinAspect = Math.max(1, Number(spanConfig?.minAspect ?? 2.2) || 2.2);
const spanGapAdaptive = Math.max(
	0,
	Math.round(Number(spanConfig?.gapAdaptive ?? 0) || 0),
);
---

<MainGridLayout title={album.title} description={album.description || album.title}>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      
      <!-- 返回按钮 -->
      <div class="mb-6">
        <a 
          href="/albums/" 
          class="inline-flex items-center gap-2 text-neutral-600 dark:text-neutral-400 hover:text-[var(--primary)] transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          {i18n(I18nKey.albumsBackToList)}
        </a>
      </div>

      <!-- 相册标题信息 -->
      <header class="mb-8">
        <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
          {album.title}
        </h1>
        
        {album.description && (
          <p class="text-neutral-600 dark:text-neutral-400 mb-4">
            {album.description}
          </p>
        )}
        
        <!-- 相册元数据 -->
        <div class="flex flex-wrap items-center gap-4 text-sm text-neutral-500 dark:text-neutral-500">
          <span>{album.photos.length} {album.photos.length > 1 ? i18n(I18nKey.albumsPhotosCount) : i18n(I18nKey.albumsPhotoCount)}</span>
          <time>{new Date(album.date).toLocaleDateString('zh-CN')}</time>
          {album.location && (
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
              </svg>
              {album.location}
            </span>
          )}
        </div>
        
        <!-- 标签 -->
        {album.tags && album.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {album.tags.map((tag: string) => (
              <span class="btn-regular h-8 text-sm px-3 rounded-lg">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- 照片网格：26.09.14 起不再有「整卡空白 + 居中圆圈」的尺寸期——
           尺寸未知的项立即按默认宽高比排版（可读、可滚动），Worker 探到真实尺寸后按帧批量校正。
           每张图自己的旋转圆圈占位保留（已排版、未加载）。 -->
      <div 
        class={`photo-gallery ${album.layout === 'masonry' ? 'masonry-layout' : 'grid-layout'}`}
        data-layout={album.layout || 'grid'}
        data-columns={album.columns || 3}
        data-span-enable={spanActive ? "1" : undefined}
        data-span-max={spanActive ? String(spanMax) : undefined}
        data-span-min-aspect={spanActive ? String(spanMinAspect) : undefined}
        data-gap-adaptive={spanActive ? String(spanGapAdaptive) : undefined}
      >
        {galleryItems.map(({ photo, index, key, dimKnown, aspectStyle }) => (
          <figure 
            class:list={["photo-item", dimKnown ? "photo-dim-known" : "photo-dim-unknown"]}
            data-key={key}
            data-dim={dimKnown ? `${photo.width},${photo.height}` : undefined}
            style={aspectStyle}
          >
            <!-- 占位层：已排版未加载的空白 + 每图旋转圆圈（加载完成/失败后隐藏） -->
            <span class="photo-placeholder" aria-hidden="true">
              <span class="photo-spinner"></span>
            </span>
            <a 
              href="javascript:void(0)"
              data-src={photo.src}
              data-fancybox={`gallery-${index}`}
              class="photo-link group"
              aria-label={photo.alt || photo.title || `Photo ${index + 1}`}
            >
              <!-- 26.09.14：补 loading="lazy"，避免日后有人给该 img 补上 src 时首屏并发拉取全部外链 -->
              <img 
                alt={photo.alt}
                class="photo-image cursor-pointer"
                data-key={key}
                data-src={photo.src}
                decoding="async"
                loading="lazy"
                width={dimKnown ? photo.width : undefined}
                height={dimKnown ? photo.height : undefined}
              />
            </a>
            <!-- 26.09.14：JS 未执行（脚本报错/被拦/被禁）时的兜底直出图，避免永久停在空占位 -->
            <noscript>
              <img class="photo-fallback-image" src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
            </noscript>
          </figure>
        ))}
      </div>
    </div>
  </div>

</MainGridLayout>

<!-- 相册渲染编排（三段式：尺寸→占位→懒加载）。模块顶层只注册一次，
     同时响应首载(DOMContentLoaded)与 swup content:replace / page:view，
     修复 SPA 跳入相册页时页面级脚本不重跑的缺陷。 -->
<script>
  import "../../../utils/album-gallery.js";
</script>

<style>
  /* ============ 布局骨架（grid / masonry 同源 CSS columns） ============ */
  .grid-layout {
    display: grid;
    gap: 1rem;
  }
  
  .grid-layout[data-columns="2"] {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }
  
  .grid-layout[data-columns="3"] {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }
  
  .grid-layout[data-columns="4"] {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  
  .masonry-layout {
    columns: 2;
    column-gap: 1rem;
  }
  
  @media (min-width: 768px) {
    .masonry-layout {
      columns: 3;
    }
  }
  
  @media (min-width: 1024px) {
    .masonry-layout[data-columns="4"] {
      columns: 4;
    }
  }
  
  .photo-gallery .photo-item {
    position: relative;
    overflow: hidden;
    border-radius: 0.5rem;
    background: rgba(148, 163, 184, 0.08);
    isolation: isolate; /* hover 缩放不溢出；与子层隔离 */
  }
  
  /* grid：CSS 1:1 裁剪（不注入 aspect-ratio） */
  .grid-layout .photo-item {
    aspect-ratio: 1 / 1;
  }
  
  .masonry-layout .photo-item {
    break-inside: avoid;
    margin-bottom: 1rem;
    width: 100%;
    aspect-ratio: 3 / 2; /* 兜底盒高：真实比例以 SSR 内联 / 运行期校正为准 */
  }

  /* ============ 占位层与图片层 ============ */
  .photo-placeholder {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(148, 163, 184, 0.1);
    transition: opacity 0.3s ease;
  }
  
  .photo-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
  }
  
  .photo-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.35s ease, transform 0.3s ease;
  }

  .photo-link:hover .photo-image {
    transform: scale(1.05);
  }
  
  /* 26.09.14：JS 未执行时的兜底直出图（noscript 内），避免永久停在空占位。
     占位层是 position:absolute + z-index:0，兜底图必须抬到它之上，
     否则会被 10% 灰底压暗，且 spinner 会一直在图上转。 */
  .photo-fallback-image {
    width: 100%;
    height: auto;
    display: block;
    position: relative;
    z-index: 2;
  }

  /* 加载完成：显示图片并隐藏占位层 */
  .photo-item.photo-loaded .photo-image {
    opacity: 1;
  }
  .photo-item.photo-loaded .photo-placeholder {
    opacity: 0;
    pointer-events: none;
  }
  
  /* 加载失败：占位（去掉 spinner） */
  .photo-item.photo-error .photo-spinner {
    display: none;
  }
  .photo-item.photo-error .photo-placeholder::after {
    content: "×";
    font-size: 1.5rem;
    line-height: 1;
    color: rgba(148, 163, 184, 0.6);
  }

  /* ============ 旋转圆圈动画 ============ */
  .photo-spinner {
    display: inline-block;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 3px solid rgba(148, 163, 184, 0.25);
    border-top-color: var(--primary, #0891b2);
    animation: photo-gallery-spin 0.8s linear infinite;
    flex: none;
  }
  
  @keyframes photo-gallery-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ============ 位图通道：<img> 被替换为 canvas 后的呈现规则 ============ */
  /* canvas 与 img 共用 .photo-image 类，这里只补 canvas 侧的差异：
     canvas 以内在像素为准，必须靠 object-fit 铺满盒子（masonry 盒子比例已由 aspect-ratio 定好） */
  canvas.photo-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 尺寸探测回填的过渡：比例变化时平滑一点，避免整列瞬间跳变
     （prefers-reduced-motion 下直接跳变） */
  .masonry-layout .photo-item {
    transition: aspect-ratio 0.25s ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .masonry-layout .photo-item {
      transition: none;
    }
  }

  /* ============ 26.09.21：超宽横图跨列（方案 B：Grid 行跨） ============
     默认不生效：只有运行期脚本（utils/photo-masonry-grid.ts）算好跨列数与行号后，
     才给容器加 [data-masonry="grid"]。没有 JS / 配置关闭 / 参数缺失 → 仍是上面的
     CSS 多列瀑布流，行为与改动前完全一致。
     行间距不靠 row-gap，而是由脚本把「间距」算进每一项的行跨里（grid-auto-rows 的整数倍），
     因此不会多出半格空白；跨列项盒子高度仍由 aspect-ratio 决定（align-self: start），
     不会被行跨撑高，所以图不会被裁。 */
  .masonry-layout[data-masonry="grid"] {
    display: grid; /* grid 容器会忽略 columns，多列布局自动让位 */
    grid-template-columns: repeat(var(--masonry-cols, 3), minmax(0, 1fr));
    column-gap: 1rem;
    row-gap: 0;
    grid-auto-rows: 4px; /* 行量化单位：与 photo-masonry-grid.ts 的 ROW_UNIT 一致 */
    align-items: start;
  }

  .masonry-layout[data-masonry="grid"] .photo-item {
    break-inside: auto;
    width: auto;
    margin-bottom: 0;
    align-self: start; /* 关键：不拉伸，盒高只由 aspect-ratio 决定 */
    transition: none; /* 重排是内部行为，不做比例过渡，避免整块抖动 */
  }
</style>

<!-- 26.09.14：<noscript> 子元素可能拿不到 Astro 作用域属性（编译器对 noscript 内容的
     作用域注入存在已知问题），故用 is:global 再兜一份，确保无 JS 时兜底图仍铺满宽度。
     该选择器只命中 noscript 内的兜底图，JS 正常时该元素不存在，无副作用。 -->
<style is:global>
  .photo-fallback-image {
    width: 100%;
    height: auto;
    display: block;
    position: relative;
    z-index: 2;
  }
</style>
