---
import { siteConfig } from "../../config";
import type { FullscreenWallpaperConfig } from "../../types/config";

interface Props {
	config: FullscreenWallpaperConfig;
	className?: string;
}

const { config, className } = Astro.props;

/**
 * 26.09.01 [2]：防御性归一化图片路径
 * 去除配置中误写的 public/ 前缀，并确保本地路径以 / 开头；http(s) 远程地址原样返回
 */
const normalizeAssetPath = (src: string): string => {
	if (!src) return src;
	if (/^(https?:)?\/\//i.test(src)) return src;
	let p = src.trim();
	if (p.startsWith("public/")) p = p.slice("public/".length);
	if (!p.startsWith("/")) p = "/" + p;
	return p;
};

// 获取当前设备类型的图片源
const getImageSources = async () => {
	let srcConfig = config.src;

	// API 图片逻辑
	if (siteConfig.banner.imageApi?.enable && siteConfig.banner.imageApi?.url) {
		try {
			const response = await fetch(siteConfig.banner.imageApi.url);
			const text = await response.text();
			const apiImages = text.split("\n").filter((line) => line.trim());
			if (apiImages.length > 0) {
				return { desktop: apiImages.map(normalizeAssetPath), mobile: apiImages.map(normalizeAssetPath) };
			}
		} catch (error) {
			console.warn("Failed to fetch images from API:", error);
		}
	}

	const toArray = (src: string | string[] | undefined): string[] => 
		Array.isArray(src) ? src : (typeof src === "string" ? [src] : []);

	if (typeof srcConfig === "object" && srcConfig !== null && !Array.isArray(srcConfig)) {
		const desktop = toArray(srcConfig.desktop);
		const mobile = toArray(srcConfig.mobile);
		const resolvedDesktop = desktop.length > 0 ? desktop : mobile;
		const resolvedMobile = mobile.length > 0 ? mobile : desktop;
		return {
			desktop: resolvedDesktop.map(normalizeAssetPath),
			mobile: resolvedMobile.map(normalizeAssetPath),
		};
	}

	// 如果是字符串或字符串数组，同时用于桌面端和移动端
	const allImages = toArray(srcConfig as string | string[]);
	return { desktop: allImages.map(normalizeAssetPath), mobile: allImages.map(normalizeAssetPath) };
};

const imageSources = await getImageSources();
const hasDesktopImages = imageSources.desktop.length > 0;
const hasMobileImages = imageSources.mobile.length > 0;

if (!hasDesktopImages && !hasMobileImages) return null;

// 轮播配置
const isCarouselEnabled = config.carousel?.enable && 
	(imageSources.desktop.length > 1 || imageSources.mobile.length > 1);
const carouselInterval = config.carousel?.interval || 5;

// 样式配置
const position = config.position || "center";
const zIndex = config.zIndex || -1;
const opacity = config.opacity || 0.8;
const blurAmount = config.blur || 0;
const positionClass = (() => {
	switch (position) {
		case "top": return "object-top";
		case "bottom": return "object-bottom";
		default: return "object-center";
	}
})();

const renderGroups = [
	{
		key: 'desktop',
		images: imageSources.desktop,
		containerClass: "hidden md:block",
		hasImages: hasDesktopImages
	},
	{
		key: 'mobile',
		images: imageSources.mobile,
		containerClass: "block md:hidden",
		hasImages: hasMobileImages
	}
];
---

<!-- 26.09.02 [14]：容器暴露 SSR 解析后的桌面/移动组实际图数（含 desktop↔mobile 回退与 imageApi 分支），供“切换壁纸”按钮判断当前设备可用壁纸数 -->
<div 
	class:list={[
		"fixed inset-0 w-full h-full overflow-hidden pointer-events-none",
		className
	]}
	style={`z-index: ${zIndex}; opacity: ${opacity}; transform: translateZ(0); perspective: 1000px;`}
	data-fullscreen-wallpaper
	data-wp-desktop-count={imageSources.desktop.length}
	data-wp-mobile-count={imageSources.mobile.length}
>
	<script is:inline>
	// 立即执行脚本：防止闪烁
	(function() {
		// 26.08.31修改，内容为：无缓存时默认 fullscreen（与配置一致），避免启动时按 banner 隐藏壁纸造成闪烁
		const mode = localStorage.getItem('wallpaperMode') || 'fullscreen';
		if (mode !== 'fullscreen') {
			document.currentScript.parentElement.style.display = 'none';
		}
	})();
	</script>

	{isCarouselEnabled ? (
		renderGroups.map(group => group.hasImages && (
			<div class={`${group.containerClass} w-full h-full relative`} style="transform: translateZ(0);">
				{group.images.map((src, index) => (
					<img
						src={src}
						alt={`${group.key} wallpaper ${index + 1}`}
						class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${positionClass}`}
						data-carousel-item={index}
						style={`transform: translateZ(0); backface-visibility: hidden; will-change: opacity; ${blurAmount > 0 ? `filter: blur(${blurAmount}px);` : ''}; opacity: ${index === 0 ? 1 : 0};`}
						decoding="async"
						loading={index === 0 ? "eager" : "lazy"} 
					/>
				))}
			</div>
		))
	) : (
		<div id="wallpaper-single-container" class="w-full h-full relative">
			<script is:inline define:vars={{ desktopImages: imageSources.desktop, mobileImages: imageSources.mobile, positionClass, blurAmount }}>
				(function() {
					const getRandomImage = (images, storageKey) => {
						if (images.length === 0) return null;
						if (images.length === 1) return images[0];
						
						const lastIndex = sessionStorage.getItem(storageKey);
						let newIndex;
						
						do {
							newIndex = Math.floor(Math.random() * images.length);
						} while (newIndex === parseInt(lastIndex || '-1'));
						
						sessionStorage.setItem(storageKey, newIndex.toString());
						return images[newIndex];
					};
					
					const desktopSrc = getRandomImage(desktopImages, 'wallpaper_desktop_index');
					const mobileSrc = getRandomImage(mobileImages, 'wallpaper_mobile_index');
					
					const container = document.getElementById('wallpaper-single-container');
					
					if (desktopSrc) {
						const desktopDiv = document.createElement('div');
						desktopDiv.className = 'hidden lg:block w-full h-full relative';
						desktopDiv.style.transform = 'translateZ(0)';
						desktopDiv.innerHTML = `
							<img
								src="${desktopSrc}"
								alt="desktop wallpaper"
								class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${positionClass}"
								style="transform: translateZ(0); backface-visibility: hidden; will-change: opacity; ${blurAmount > 0 ? `filter: blur(${blurAmount}px);` : ''} opacity: 1;"
								decoding="async"
								loading="eager"
							/>
						`;
						container.appendChild(desktopDiv);
					}
					
					if (mobileSrc) {
						const mobileDiv = document.createElement('div');
						mobileDiv.className = 'block lg:hidden w-full h-full relative';
						mobileDiv.style.transform = 'translateZ(0)';
						mobileDiv.innerHTML = `
							<img
								src="${mobileSrc}"
								alt="mobile wallpaper"
								class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${positionClass}"
								style="transform: translateZ(0); backface-visibility: hidden; will-change: opacity; ${blurAmount > 0 ? `filter: blur(${blurAmount}px);` : ''} opacity: 1;"
								decoding="async"
								loading="eager"
							/>
						`;
						container.appendChild(mobileDiv);
					}
				})();
			</script>
		</div>
	)}
	<script is:inline>
	// 26.09.01修改，内容为：解析期（首帧前）按 sessionStorage 保存的轮播索引恢复背景图可见性，消除刷新时“先显示第 0 张、再淡入切换”的渲染残留
	(function() {
		var savedIndex = parseInt(sessionStorage.getItem('mizuki_wallpaper_index') || '0', 10);
		var container = document.currentScript.parentElement;
		if (!container) return;
		container.querySelectorAll('.hidden.md\\:block, .block.md\\:hidden').forEach(function(group) {
			var items = group.querySelectorAll('[data-carousel-item]');
			if (items.length === 0) return;
			var safeIndex = (savedIndex >= 0 && savedIndex < items.length) ? savedIndex : 0;
			for (var i = 0; i < items.length; i++) {
				items[i].style.opacity = i === safeIndex ? '1' : '0';
			}
		});
	})();
	</script>
</div>

{isCarouselEnabled && (
	<script is:inline define:vars={{ carouselInterval, carouselEnabled: config.carousel?.enable }}>
		/**
		 * 26.09.01 [3]：移除 setInterval 定时自动轮播，改为暴露 window.__mizukiSwitchWallpaper 手动切换接口
		 * 由 MainGridLayout 的 swup 钩子在“页面切换且目标页为主页”时调用：随机换图（>2 张时保证前后不同）、
		 * 复用图片的 transition-opacity duration-1000 实现 1s 渐变淡出/淡入；
		 * 距上次切换不足 carousel.interval 秒则跳过；carousel.enable 仍为总开关（false 时直接返回）
		 * 26.09.02 [14]：新增可选参数 force——true 时跳过最小间隔检查（“切换壁纸”按钮手动触发），
		 * 仍执行随机换图/渐变并写回 mizuki_wallpaper_index/last_switch；swup 自动触发不传 force，保持原间隔门控
		 */
		function initFullscreenWallpaperSwitch() {
			const container = document.querySelector('[data-fullscreen-wallpaper]');
			if (!container) return;

			const INDEX_KEY = 'mizuki_wallpaper_index';
			const LAST_SWITCH_KEY = 'mizuki_wallpaper_last_switch';

			// 手动切换接口：页面切至主页时由 swup 钩子触发；force=true 由“切换壁纸”按钮触发（绕过间隔门控）
			window.__mizukiSwitchWallpaper = function(force) {
				// 总开关：enable=false 时完全不切换
				if (!carouselEnabled) return;
				if (!container || !document.body.contains(container)) return;

				// 最小切换间隔检查（首次/无记录时允许切换）
				const lastSwitch = parseInt(sessionStorage.getItem(LAST_SWITCH_KEY) || '0', 10);
				// 26.09.02 [14]：force=true 时跳过间隔检查（切换后仍写回 last_switch，重新计时）
				if (!force && lastSwitch && Date.now() - lastSwitch < carouselInterval * 1000) return;

				// 按设备类型确定目标组（md 断点：桌面组 hidden.md:block / 移动组 block.md:hidden）
				const isDesktop = window.matchMedia && window.matchMedia('(min-width: 768px)').matches;
				const items = isDesktop
					? container.querySelectorAll('.hidden.md\\:block [data-carousel-item]')
					: container.querySelectorAll('.block.md\\:hidden [data-carousel-item]');
				const length = items.length;
				// 长度 1 或空则忽略
				if (length <= 1) return;

				const savedIndex = parseInt(sessionStorage.getItem(INDEX_KEY) || '0', 10);
				const currentIndex = (savedIndex >= 0 && savedIndex < length) ? savedIndex : 0;

				let newIndex;
				if (length === 2) {
					// 两张图直接互切，保证必定换图
					newIndex = 1 - currentIndex;
				} else {
					// >2 张：循环随机直到与当前索引不同，保证前后两次不选同一张
					do {
						newIndex = Math.floor(Math.random() * length);
					} while (newIndex === currentIndex);
				}

				// 渐变切换：旧图淡出、新图淡入（复用 transition-opacity duration-1000）
				items[currentIndex].style.opacity = '0';
				items[newIndex].style.opacity = '1';

				sessionStorage.setItem(INDEX_KEY, newIndex.toString());
				sessionStorage.setItem(LAST_SWITCH_KEY, Date.now().toString());
			};
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initFullscreenWallpaperSwitch);
		} else {
			initFullscreenWallpaperSwitch();
		}
	</script>
)}
