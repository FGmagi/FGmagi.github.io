/atom.xml
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET
  Access-Control-Max-Age: 86400

/rss.xml
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET
  Access-Control-Max-Age: 86400

# 自托管静态图片资源：自托管内容带内容 hash / 长期引用，浏览器可安全长缓存（一年）
/images/*.webp
  Cache-Control: public, max-age=31536000, immutable

/images/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/images/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/images/*.png
  Cache-Control: public, max-age=31536000, immutable

/images/*.gif
  Cache-Control: public, max-age=31536000, immutable

/images/*.avif
  Cache-Control: public, max-age=31536000, immutable