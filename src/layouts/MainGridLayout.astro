/* 手机端非首页隐藏banner - 改进的分阶段动画 */
@media (max-width: 1279px) {
    #banner-wrapper {
        transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.3s ease-out;
        transform-origin: top center;
        /* 硬件加速优化 */
        will-change: transform, opacity;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        transform: translateZ(0);
        -webkit-transform: translateZ(0);
    }
    
    .mobile-hide-banner {
        transform: translateY(-100%) translateZ(0) !important;
        opacity: 0 !important;
        pointer-events: none !important;
        /* 快速消失 */
        transition: transform 0.3s ease-in, opacity 0.2s ease-in !important;
    }
    
    /* 主内容区域位置过渡：⚠ 26.09.14 改为只跟着「显式切换壁纸模式」走（横幅模式遗留修复）。
       原先无条件给 .absolute.w-full.z-30 挂 `transition: top 0.4s ... 0.1s`，
       于是「首载时按当前模式把 top 修正到正确值」这件纯内部的事被播成了 0.4 秒的可见位移
       （配合上面那条漏写模式前缀的横屏规则 ⇒ 首屏内容卡片上移一段）。
       现在首载/换页一律即时就位；只有 applyWallpaperMode(animate=true) 期间
       （body.wallpaper-mode-transition，全屏↔隐藏壁纸）才播这段过渡。 */
    body.wallpaper-mode-transition .absolute.w-full.z-30 {
        transition: top 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.1s;
        /* 硬件加速优化 */
        will-change: top;
        /* 禁用transform以保证back to top 按钮可以显示
        transform: translateZ(0);
        -webkit-transform: translateZ(0);
        */
    }
    
    .absolute.w-full.z-30.mobile-main-no-banner {
        top: 5.5rem !important;
        min-height: calc(100vh - 5.5rem) !important;
        /* 内容区域快速上移：这是移动端横幅模式**专属**的编排（离开首页时 banner 收起、
           内容跟着上移），过渡只挂在这个类上 ⇒ 只有 JS 主动加类时才播，
           首载/刷新永远不会因此出现位移（首载位置由模式类一次定死）。 */
        transition: top 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s !important;
    }
}

