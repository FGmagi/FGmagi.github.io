---
import type { CollectionEntry } from "astro:content";
import type { Page } from "astro";
import PostCard from "./PostCard.astro";

interface Props {
	page: Page<CollectionEntry<"posts">>;
}

const { page } = Astro.props;
---

<div
	id="post-list-container"
	class="list-mode rounded-[var(--radius-large)] bg-[var(--card-bg)] overflow-hidden mb-4"
	data-default-layout="list"
>
	{
		page.data.map((entry, index) => (
			<PostCard
				entry={entry}
				class="onload-animation"
				style={`--i: ${index};`}
			/>
		))
	}
</div>

<style>
	#post-list-container {
		display: flex;
		flex-direction: column;
		min-height: min(200px, 45vh);
	}
	#post-list-container > :global(*) {
		min-width: 0;
	}
	#post-list-container > :global([data-search-match="false"]) {
		display: none !important;
	}
</style>
