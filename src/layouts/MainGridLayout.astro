---
import BackToTop from "@components/control/BackToTop.astro";
import FloatingTOC from "@components/control/FloatingTOC.astro";
import Footer from "@components/Footer.astro";
import RightSideBar from "@components/layout/RightSideBar.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import FullscreenWallpaper from "../components/misc/FullscreenWallpaper.astro";
import IconifyLoader from "../components/misc/IconifyLoader.astro";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TypewriterText from "../components/TypewriterText.astro";
import TOC from "../components/widget/TOC.astro";
import {
	fullscreenWallpaperConfig,
	siteConfig,
} from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	// BANNER_HEIGHT_HOME,
	// MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import { widgetManager } from "../utils/widget-manager";
import Layout from "./Layout.astro";

// TOC模式配置
const tocMode = siteConfig.toc.mode || "float";
const isFloatTOC = tocMode === "float";
const isSidebarTOC = tocMode === "sidebar";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	headings?: MarkdownHeading[];
	// 26.08.30修改，内容为：新增 fill 属性，主页列表页填充视口高度（不足8篇时分页图标贴视觉底部）
	fill?: boolean;
}

// 类型守卫函数
// const isBannerSrcObject = (
// 	src:
// 		| string
// 		| string[]
// 		| { desktop?: string | string[]; mobile?: string | string[] },
// ): src is { desktop?: string | string[]; mobile?: string | string[] } => {
// 	return (
// 		typeof src === "object" &&
// 		src !== null &&
// 		!Array.isArray(src) &&
// 		("desktop" in src || "mobile" in src)
// 	);
// };

/**
 * 26.09.01 [2]：防御性归一化图片路径
 * 去除配置中误写的 public/ 前缀，并确保本地路径以 / 开头；http(s) 远程地址原样返回；兼容 string 与数组
 */
const normalizeAssetPath = (src: string | string[]): string | string[] => {
	const normalizeOne = (s: string): string => {
		if (!s) return s;
		if (/^(https?:)?\/\//i.test(s)) return s;
		let p = s.trim();
		if (p.startsWith("public/")) p = p.slice("public/".length);
		if (!p.startsWith("/")) p = "/" + p;
		return p;
	};
	if (Array.isArray(src)) return src.map(normalizeOne);
	return normalizeOne(src);
};

// 获取banner图片的辅助函数
const getBannerImages = async () => {
	let bannerSrc = siteConfig.banner.src;

	// 如果启用了图片API，获取API图片
	if (siteConfig.banner.imageApi?.enable && siteConfig.banner.imageApi?.url) {
		try {
			const response = await fetch(siteConfig.banner.imageApi.url);
			const text = await response.text();
			const apiImages = text.split("\n").filter((line) => line.trim());

			if (apiImages.length > 0) {
				bannerSrc = apiImages;
			}
		} catch (error) {
			console.warn("Failed to fetch images from API:", error);
		}
	}

	if (
		typeof bannerSrc === "object" &&
		bannerSrc !== null &&
		!Array.isArray(bannerSrc) &&
		("desktop" in bannerSrc || "mobile" in bannerSrc)
	) {
		const srcObj = bannerSrc as {
			desktop?: string | string[];
			mobile?: string | string[];
		};
		return {
			desktop: normalizeAssetPath(srcObj.desktop || srcObj.mobile || ""),
			mobile: normalizeAssetPath(srcObj.mobile || srcObj.desktop || ""),
		};
	}
	// 如果是字符串或字符串数组，同时用于桌面端和移动端
	// 26.09.02 [7]：bannerSrc 在 imageApi 分支被重新赋值，TS 无法收窄掉对象分支，显式断言修复 astro check 类型错误（行为不变）
	const flatBannerSrc = bannerSrc as string | string[];
	return {
		desktop: normalizeAssetPath(flatBannerSrc),
		mobile: normalizeAssetPath(flatBannerSrc),
	};
};

const bannerImages = await getBannerImages();

// 26.09.01 [3]：默认 fullscreen 时强制横幅桌面图源为空，从源头杜绝 wideBanner.desktop 首帧渲染/闪现（F-01）
const isFullscreenDefault = siteConfig.wallpaperMode.defaultMode === "fullscreen";
const bannerDesktopImages = isFullscreenDefault ? [] : bannerImages.desktop;

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	headings = [],
	fill = false,
} = Astro.props;
const hasBannerCredit = siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

// 检查是否为首页
const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";
const showHomeText = siteConfig.banner.homeText?.enable && isHomePage;
// 手机端非首页不显示banner的CSS类
const mobileNonHomeBannerClass = !isHomePage ? "mobile-hide-banner" : "";

// 计算主内容区域位置，考虑手机端非首页时banner被隐藏
// 当默认模式为 banner 时，使用banner高度；否则使用顶栏高度
// 让主内容区域紧贴波浪线下方，波浪线高度约为10-15vh，所以主内容从banner顶部开始
const mainPanelTop =
	siteConfig.wallpaperMode.defaultMode === "banner"
		? `${BANNER_HEIGHT}vh`
		: "5.5rem";
// const mobileNonHomeMainTop = !isHomePage ? "5.5rem" : mainPanelTop;

// 当默认模式不是 banner 时，主内容区域应该始终从顶栏下面开始
const finalMainPanelTop =
	siteConfig.wallpaperMode.defaultMode === "banner" ? mainPanelTop : "5.5rem";

// 26.08.30修改，内容为：左右侧边栏、手机 drawer、平板侧边栏是否显示均增加"仅首页显示"限制（isHomePage），非首页隐藏全部磁贴
// 检查左侧边栏是否有组件（仅首页显示）
const hasLeftSidebarComponents =
	isHomePage &&
	(widgetManager.getComponentsByPosition("top", "left", "desktop").length > 0 ||
		widgetManager.getComponentsByPosition("sticky", "left", "desktop").length > 0);

// 检查右侧边栏是否有组件（仅首页显示）
const hasRightSidebarComponents =
	isHomePage &&
	(widgetManager.getComponentsByPosition("top", "right", "desktop").length > 0 ||
		widgetManager.getComponentsByPosition("sticky", "right", "desktop").length > 0);

// 检查手机端 drawer 是否有组件（仅首页显示）
const hasMobileDrawerComponents =
	isHomePage &&
	(widgetManager.getComponentsByPosition("top", "drawer", "mobile").length > 0 ||
		widgetManager.getComponentsByPosition("sticky", "drawer", "mobile").length > 0);

// 平板端是否有组件（考虑自动移动逻辑，仅首页显示）
const hasTabletLeftSidebarComponents =
	isHomePage &&
	(widgetManager.getComponentsByPosition("top", "left", "tablet").length > 0 ||
		widgetManager.getComponentsByPosition("sticky", "left", "tablet").length > 0);

// 检查侧边栏是否启用，动态调整网格布局
const mobileShowSidebar = hasMobileDrawerComponents;
const desktopShowSidebar = hasLeftSidebarComponents || hasRightSidebarComponents;

// 桌面端侧边栏最终显示状态（考虑是否有组件）
const desktopShowLeftSidebar = hasLeftSidebarComponents;
const desktopShowRightSidebar = hasRightSidebarComponents;

// 平板端侧边栏最终显示状态
const tabletShowLeftSidebar = hasTabletLeftSidebarComponents;
// 如果左侧有组件，则平板端不显示右侧侧栏；只有当左侧为空且右侧有组件时，才显示右侧侧栏（会被移到左侧）
// 注意：现在 getComponentsByPosition("left", "tablet") 已经包含了这个逻辑
const tabletShowRightSidebar = false; // 平板端不再有独立的右侧栏，如果右移左了，它就在 tabletShowLeftSidebar 中显示
const tabletAnySidebar = tabletShowLeftSidebar;

// 检查默认布局模式，如果是 grid 模式，右侧边栏初始就应该隐藏
const defaultPostListLayout = siteConfig.postListLayout?.defaultMode || "list";
const initialRightSidebarHidden = defaultPostListLayout === "grid";

// 动态网格布局类名 - 根据侧边栏模式和是否有组件调整列宽
let desktopGridCols = "lg:grid-cols-1";
if (desktopShowLeftSidebar && desktopShowRightSidebar) {
	desktopGridCols = "lg:grid-cols-[17.5rem_1fr_17.5rem]";
} else if (desktopShowLeftSidebar) {
	desktopGridCols = "lg:grid-cols-[17.5rem_1fr]";
} else if (desktopShowRightSidebar) {
	desktopGridCols = "lg:grid-cols-[1fr_17.5rem]";
}

const gridCols = `
	${mobileShowSidebar ? "grid-cols-1" : "grid-cols-1"}
	${tabletAnySidebar ? "md:grid-cols-[17.5rem_1fr]" : "md:grid-cols-1"}
	${desktopGridCols}
`
	.trim()
	.replace(/\s+/g, " ");

// 侧边栏容器类名 - 始终在左侧
const sidebarClass = `
	onload-animation
	${mobileShowSidebar && hasMobileDrawerComponents ? "block" : "hidden"}
	${tabletShowLeftSidebar ? "md:block md:mb-4 md:max-w-[17.5rem]" : "md:hidden"}
	${desktopShowLeftSidebar ? "lg:block lg:mb-4 lg:row-start-1 lg:row-end-2 lg:max-w-[17.5rem] lg:col-start-1 lg:col-end-2" : "lg:hidden"}
`
	.trim()
	.replace(/\s+/g, " ");

// 右侧边栏容器类名
// 手机端：隐藏（手机端只通过 drawer 显示组件）
// 平板端：根据简化逻辑显示（只有当左侧为空时才显示并移到左侧）
// 桌面端：定位到网格最后一列（右侧）
// 如果默认是 grid 模式，初始就隐藏
const rightSidebarClass = `
	onload-animation
	hidden
	${tabletShowRightSidebar ? "md:block md:mb-4 md:max-w-[17.5rem]" : "md:hidden"}
	${desktopShowRightSidebar ? `lg:block lg:mb-4 lg:row-start-1 lg:row-end-2 lg:max-w-[17.5rem] ${desktopShowLeftSidebar ? "lg:col-start-3 lg:col-end-4" : "lg:col-start-2 lg:col-end-3"} lg:col-span-1` : "lg:hidden"}
	${initialRightSidebarHidden ? "hidden-in-grid-mode" : ""}
`
	.trim()
	.replace(/\s+/g, " ");

// 主内容区域类名 - 根据侧边栏模式调整grid-column
// 平板设备和手机端：主内容在最上方row-1，侧边栏在下方
// 桌面端：主内容和侧边栏并排显示
let desktopMainPos = "lg:col-span-1";
if (desktopShowLeftSidebar && desktopShowRightSidebar) {
	desktopMainPos = "lg:col-start-2 lg:col-end-3";
} else if (desktopShowLeftSidebar) {
	desktopMainPos = "lg:col-start-2 lg:col-end-3";
} else if (desktopShowRightSidebar) {
	desktopMainPos = "lg:col-start-1 lg:col-end-2";
}

const mainContentClass = `
	transition-swup-fade overflow-hidden w-full
	col-span-1 row-start-1 row-end-2
	${tabletAnySidebar ? "md:col-start-2 md:col-end-3" : "md:col-start-1 md:col-end-2"}
	${desktopShowSidebar ? desktopMainPos : "lg:col-span-1"}
`
	.trim()
	.replace(/\s+/g, " ");

// 26.08.31修改，内容为：透明状态改由 body.wallpaper-transparent 统一控制，移除静态标记，确保隐藏壁纸模式清除毛玻璃效果
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug}>

<!-- 26.09.14：首帧预渲染门（解析期同步脚本，位于 body 内容最前）。
     首次打开网页 / 刷新：页面必须先完成预渲染，再统一渐变显示。
     为什么必须在这里挂类（而不是等下面那段模块脚本）：
       · 模块脚本在文档解析完成后才执行，浏览器可能已经绘制过首帧 ⇒ 会先闪一下完整页面；
       · 本脚本是解析期同步脚本，执行时 body 已存在、主内容尚未解析 ⇒ 不可能出现可见首帧；
       · 换页时 swup 的 ScriptsPlugin 会把本脚本重放一遍（不是「不再执行」），所以用
         window.__pageTransitionBooted 做幂等守卫：只有真正首载/刷新才挂门，重放直接退出。
         挂门 + 该标记就是「首载」的唯一判据（src/utils/page-transition.ts 读
         window.__pagePrerenderArmed 决定是否走首载分支）。
     可见性规则见 Layout.astro 的 <head> 内联 <style>（同一次布局计算内即可生效）。 -->
<script is:inline>
	(function () {
		// ⚠ 换页时 swup 的 ScriptsPlugin 会把本文档里的内联脚本重放一遍 ⇒ 本段会被重复执行。
		//   只有「首次打开 / 刷新」才该挂门：已启动过就直接退出，否则重放会把预渲染门
		//   在换页之后重新挂回 body，而此时控制器已经收尾（phase=idle）不会再来摘它
		//   ⇒ 新页面永久停在不可见。
		if (window.__pageTransitionBooted) return;
		window.__pageTransitionBooted = true;
		var b = document.body;
		if (!b) return;
		// 标记「本次是首载 / 刷新」：控制器据此走首载分支，预渲染完成后由它摘掉
		window.__pagePrerenderArmed = true;
		b.classList.add('page-prerender');
	})();
</script>

<!-- 26.09.14：页面切换渐变控制器（模块副作用：写 CSS 时长变量、注册 swup 钩子、
     处理首载预渲染后的统一渐显）。用普通 <script> 让 Vite 打包，写法和本仓库其余模块脚本一致。 -->
<script>
	import "../utils/page-transition.ts";
</script>

<script type="module" is:inline define:vars={{navbarTransparentMode: siteConfig.banner?.navbar?.transparentMode || "semi", defaultWallpaperMode: siteConfig.wallpaperMode.defaultMode, defaultPostListLayout: siteConfig.postListLayout?.defaultMode || "list", BANNER_HEIGHT: BANNER_HEIGHT, pageScaling: siteConfig.pageScaling}}>

	// 26.08.30修改，内容为：页面渲染前始终强制使用列表模式（布局切换按钮已隐藏），并应用简洁模式（默认开启，隐藏左右磁贴）

	// 立即执行，在页面渲染前应用壁纸模式和布局模式，避免闪烁
	(function() {
		// 列表/网格切换按钮已隐藏，始终使用列表模式（覆盖此前保存的 grid 缓存）
		localStorage.setItem('postListLayout', 'list');
		sessionStorage.setItem('postListLayout', 'list');

		const wallpaperMode = localStorage.getItem('wallpaperMode') || defaultWallpaperMode;
		const body = document.body;
		
		// 26.08.31修改，内容为：简洁模式默认改为关闭（常规模式），仅当存储值为 true 时启用
		const simpleMode = localStorage.getItem('simpleMode');
		if (simpleMode === 'true') {
			body.classList.add('simple-mode');
		} else {
			body.classList.remove('simple-mode');
		}

		// 定义 banner 高度常量（与 constants.ts 保持一致）
		// const BANNER_HEIGHT = 35;
		// const BANNER_HEIGHT_EXTEND = 30;
		// const BANNER_HEIGHT_HOME = BANNER_HEIGHT + BANNER_HEIGHT_EXTEND;
		// const MAIN_PANEL_OVERLAPS_BANNER_HEIGHT = 3.5;
		
		// 立即应用 body 类，确保首次渲染就是正确的状态
		switch(wallpaperMode) {
			case 'banner':
				body.classList.add('enable-banner');
				body.classList.remove('wallpaper-transparent', 'no-banner-mode');
				break;
			case 'fullscreen':
				body.classList.remove('enable-banner');
				body.classList.add('wallpaper-transparent', 'no-banner-mode');
				break;
			case 'none':
				body.classList.remove('enable-banner', 'wallpaper-transparent');
				body.classList.add('no-banner-mode');
				break;
		}
		
		// 立即应用布局模式（避免闪烁和位置错误）
		// 使用 requestAnimationFrame 确保 DOM 准备好
		requestAnimationFrame(function() {
			// ⚠ 26.09.14：这里原本还会用 requestAnimationFrame 写 mainContent.style.top
			//   （banner → `${BANNER_HEIGHT}vh`，其余 → 5.5rem）——横幅模式遗留代码。
			//   主面板的 top 现在完全由 CSS 按模式与断点决定（body.enable-banner 的
			//   70vh/75vh/60vh/35vh 与 body.no-banner-mode 的 5.5rem），而且模式类在解析期
			//   就已写好、早于首帧 ⇒ 首载时没有任何位置变化。留着这段 JS 只会在首帧之后再改
			//   一次内联 top，把「内部修正」变成可见位移（首屏内容卡片上移的成因之一）。
			//
			// 立即应用布局模式，避免闪烁
			const mainGrid = document.getElementById('main-grid');
			if (mainGrid) {
				const savedLayout = localStorage.getItem('postListLayout');
				const currentLayout = savedLayout || defaultPostListLayout;
				mainGrid.setAttribute('data-layout-mode', currentLayout);
				
				// 根据布局模式显示或隐藏右侧边栏
				const rightSidebar = document.querySelector('.right-sidebar-container');
				if (rightSidebar) {
					if (currentLayout === 'grid') {
						rightSidebar.classList.add('hidden-in-grid-mode');
					} else {
						rightSidebar.classList.remove('hidden-in-grid-mode');
					}
				}
				
				// 同时更新文章列表容器的CSS类
				const postListContainer = document.getElementById('post-list-container');
				if (postListContainer) {
					postListContainer.classList.remove('list-mode', 'grid-mode');
					
					if (currentLayout === 'grid') {
						postListContainer.classList.add('grid-mode');
						postListContainer.classList.add('grid', 'grid-cols-1', 'lg:grid-cols-2', 'gap-6');
						postListContainer.classList.remove('flex', 'flex-col');
					} else {
						postListContainer.classList.add('list-mode');
						postListContainer.classList.add('flex', 'flex-col');
						postListContainer.classList.remove('grid', 'grid-cols-1', 'lg:grid-cols-2', 'gap-6');
					}
				}
			}
		});
	})();
	
	// 根据壁纸模式动态设置 banner 和全屏壁纸的显示
	// const wallpaperMode = localStorage.getItem('wallpaperMode') || defaultWallpaperMode;
	
	// 在 DOM 加载后执行
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', applyWallpaperMode);
	} else {
		applyWallpaperMode();
	}
	
	// 26.09.02 [14]：全屏↔隐藏壁纸模式切换增加背景渐变过渡——全屏→隐藏先淡出壁纸再切终态，
	// 隐藏→全屏先 display:block + opacity:0 强制一帧再淡入并加回透明类；
	// 时长与 [data-fullscreen-wallpaper] 既有 opacity 0.6s 过渡一致；prefers-reduced-motion 下直接切换；
	// 初始加载 / swup 切页不传 animate，保持任务D 首帧缓冲与 F-02 门控语义
	var wallpaperModeTransitionMs = 600;
	var wallpaperModeTimer = null;

	function cancelWallpaperModeTransition() {
		if (wallpaperModeTimer) {
			clearTimeout(wallpaperModeTimer);
			wallpaperModeTimer = null;
		}
		document.body.classList.remove('wallpaper-mode-transition');
	}

	function prefersReducedWallpaperMotion() {
		return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
	}

	function applyWallpaperBannerState() {
		var bannerWrapper = document.getElementById('banner-wrapper');
		var fullscreenWallpaper = document.querySelector('[data-fullscreen-wallpaper]');
		var navbar = document.getElementById('navbar');
		var body = document.body;
		var mainContent = document.querySelector('.absolute.w-full.z-30.pointer-events-none');
		var tocWrapper = document.getElementById('toc-wrapper');
		var forceReflow = function() { void document.body.offsetHeight; };

		if (bannerWrapper) bannerWrapper.style.display = 'block';
		if (fullscreenWallpaper) fullscreenWallpaper.style.display = 'none';
		if (tocWrapper) {
			var scrollTop = document.documentElement.scrollTop;
			var bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100);
			if (scrollTop <= bannerHeight) tocWrapper.classList.add('toc-hide');
		}
		body.classList.remove('wallpaper-transparent');
		body.classList.remove('no-banner-mode');
		forceReflow();
		if (mainContent) mainContent.style.removeProperty('top');
		body.classList.add('enable-banner');
		if (navbar) {
			navbar.removeAttribute('data-dynamic-transparent');
			navbar.setAttribute('data-transparent-mode', navbarTransparentMode);
			if (navbarTransparentMode === 'semifull' && window.initSemifullScrollDetection) {
				window.initSemifullScrollDetection();
			}
		}
		forceReflow();
	}

	function applyWallpaperFullscreenState() {
		var bannerWrapper = document.getElementById('banner-wrapper');
		var fullscreenWallpaper = document.querySelector('[data-fullscreen-wallpaper]');
		var navbar = document.getElementById('navbar');
		var body = document.body;
		var mainContent = document.querySelector('.absolute.w-full.z-30.pointer-events-none');
		var tocWrapper = document.getElementById('toc-wrapper');
		var forceReflow = function() { void document.body.offsetHeight; };

		if (bannerWrapper) bannerWrapper.style.display = 'none';
		if (fullscreenWallpaper) fullscreenWallpaper.style.display = 'block';
		if (tocWrapper) tocWrapper.classList.remove('toc-hide');
		body.classList.remove('enable-banner');
		forceReflow();
		if (mainContent) mainContent.style.removeProperty('top');
		body.classList.add('wallpaper-transparent');
		body.classList.add('no-banner-mode');
		if (navbar) {
			navbar.setAttribute('data-dynamic-transparent', 'semi');
			navbar.removeAttribute('data-transparent-mode');
		}
		forceReflow();
	}

	function applyWallpaperNoneState() {
		var bannerWrapper = document.getElementById('banner-wrapper');
		var fullscreenWallpaper = document.querySelector('[data-fullscreen-wallpaper]');
		var navbar = document.getElementById('navbar');
		var body = document.body;
		var mainContent = document.querySelector('.absolute.w-full.z-30.pointer-events-none');
		var tocWrapper = document.getElementById('toc-wrapper');
		var forceReflow = function() { void document.body.offsetHeight; };

		if (bannerWrapper) bannerWrapper.style.display = 'none';
		if (fullscreenWallpaper) fullscreenWallpaper.style.display = 'none';
		if (tocWrapper) tocWrapper.classList.remove('toc-hide');
		body.classList.remove('enable-banner');
		body.classList.remove('wallpaper-transparent');
		forceReflow();
		if (mainContent) mainContent.style.removeProperty('top');
		body.classList.add('no-banner-mode');
		if (navbar) {
			navbar.setAttribute('data-dynamic-transparent', 'none');
			navbar.removeAttribute('data-transparent-mode');
		}
		forceReflow();
	}

	function applyWallpaperMode(animate) {
		cancelWallpaperModeTransition();
		var wallpaperMode = localStorage.getItem('wallpaperMode') || defaultWallpaperMode;
		var fullscreenWallpaper = document.querySelector('[data-fullscreen-wallpaper]');
		var canAnimate = !!animate && !!fullscreenWallpaper && !prefersReducedWallpaperMotion();

		// 全屏 → 隐藏壁纸：壁纸先淡出，过渡结束再切到 none 终态（display:none + 移除透明类），避免生硬跳变
		if (wallpaperMode === 'none' && canAnimate && fullscreenWallpaper.style.display !== 'none') {
			document.body.classList.add('wallpaper-mode-transition');
			fullscreenWallpaper.style.setProperty('opacity', '0', 'important');
			wallpaperModeTimer = setTimeout(function() {
				wallpaperModeTimer = null;
				document.body.classList.remove('wallpaper-mode-transition');
				applyWallpaperNoneState();
				fullscreenWallpaper.style.removeProperty('opacity');
			}, wallpaperModeTransitionMs + 40);
			return;
		}

		// 隐藏壁纸 → 全屏：先 display:block + opacity:0 并强制一帧，再淡入并加回 wallpaper-transparent 等类
		if (wallpaperMode === 'fullscreen' && canAnimate && fullscreenWallpaper.style.display === 'none') {
			document.body.classList.add('wallpaper-mode-transition');
			var bannerWrapper = document.getElementById('banner-wrapper');
			if (bannerWrapper) bannerWrapper.style.display = 'none';
			fullscreenWallpaper.style.display = 'block';
			fullscreenWallpaper.style.setProperty('opacity', '0', 'important');
			applyWallpaperFullscreenState();
			void document.body.offsetHeight;
			requestAnimationFrame(function() {
				if (fullscreenWallpaper.style.display !== 'none') {
					fullscreenWallpaper.style.removeProperty('opacity');
				}
			});
			wallpaperModeTimer = setTimeout(function() {
				wallpaperModeTimer = null;
				document.body.classList.remove('wallpaper-mode-transition');
				if (fullscreenWallpaper.style.display !== 'none') {
					fullscreenWallpaper.style.removeProperty('opacity');
				}
			}, wallpaperModeTransitionMs + 40);
			return;
		}

		switch (wallpaperMode) {
			case 'banner':
				applyWallpaperBannerState();
				if (fullscreenWallpaper) fullscreenWallpaper.style.removeProperty('opacity');
				break;
			case 'fullscreen':
				applyWallpaperFullscreenState();
				if (fullscreenWallpaper) fullscreenWallpaper.style.removeProperty('opacity');
				break;
			case 'none':
				applyWallpaperNoneState();
				if (fullscreenWallpaper) fullscreenWallpaper.style.removeProperty('opacity');
				break;
		}
	}
	
	// 监听壁纸模式变化，立即应用（不重载页面）；用户切换时播放背景渐变过渡（animate=true）
	window.addEventListener('wallpaper-mode-change', function(_event) {
		applyWallpaperMode(true);
	});
	
	// 26.08.30修改，内容为：新增监听 simple-mode-change 事件，实时切换 body 的 simple-mode 类（无需刷新页面）

	// 监听简洁模式变化，立即应用（不重载页面）
	window.addEventListener('simple-mode-change', function(event) {
		const simple = event.detail && event.detail.simple;
		if (simple) {
			document.body.classList.add('simple-mode');
		} else {
			document.body.classList.remove('simple-mode');
		}
	});

	/** 摘掉新页容器内所有入场动画类：只摘类、不动内联样式，避免与 CSS 动画打架 */
	function stripRegionEnterAnimations(region) {
		if (!region) return;
		const nodes = region.querySelectorAll('.onload-animation');
		if (nodes.length > 0) {
			nodes.forEach(function(element) {
				element.classList.remove('onload-animation');
			});
		}
		// #toc-swup-region 本身可能是空壳（非文章页），此时什么都不用做
	}

	// 26.08.31修改，内容为：Swup 页面切换统一由 #main-grid 控制淡出和淡入，清除新节点动画并保留 page-entering 至渐变结束
	// 26.09.14修改，内容为：连带清除 #toc-swup-region（目录 rail 随 swup 换页换新，同样带 onload-animation）——
	// 否则该类自己的 150ms 延迟 + 500ms 淡入会在 page-entering 结束后重新触发，目录闪一下。
	function clearPageRegionAnimations() {
		const regions = ['#main-grid', '#toc-swup-region'];
		regions.forEach(function(selector) {
			stripRegionEnterAnimations(document.querySelector(selector));
		});
	}

	/* 26.09.14：页面切换渐变改由独立控制器负责（src/utils/page-transition.ts，在本布局顶部 import）。
	   控制器统一处理：点击 → 整页渐变消失(fadeOut) → 目标页加载 → 预渲染 → 统一渐变显示(fadeIn)，
	   同 URL 点击同样「消失 → 重新加载 → 重新预渲染 → 渐显」，首载/刷新也必须先预渲染再渐显。
	   本文件只保留与「布局」强相关的职责（与渐变时序无关）：
	     · stripRegionEnterAnimations / clearPageRegionAnimations：摘掉新页容器的入场动画类；
	     · setupSwupLayoutSync：布局模式应用、主页壁纸切换、新页入场动画清理。
	   时长唯一来源：siteConfig.pageTransition（见 config.ts），CSS 侧读 --page-fade-out / --page-fade-in。 */

	function setupSwupLayoutSync() {
		// @ts-ignore
		if (typeof window !== 'undefined' && window.swup) {
			// 26.09.01 [3]：visit:start 阶段记录目标页是否为主页（content:replace 阶段 location 可能尚未更新），供主页背景切换判断
			// @ts-ignore
			window.swup.hooks.on('visit:start', function(visit) {
				var targetPath = visit && visit.to ? visit.to.url : '';
				try {
					targetPath = new URL(visit.to.url, window.location.origin).pathname;
				} catch (e) { /* 保持原始字符串 */ }
				window.__pendingTargetHome = targetPath === '/' || targetPath === '';
			});

			// 在内容替换后立即应用布局，不等待其他脚本
			// ⚠ 本钩子用 on() 注册 ⇒ 位于 swup 默认 handler（content:replace 的默认 handler 才是真正换 DOM）
			// **之后**（Hooks.getHandlers/call 的执行序 = before → 默认 handler → on()）⇒ 这里拿到的已经是【新 DOM】。
			// @ts-ignore
			window.swup.hooks.on('content:replace', function() {
				// 新页节点就位后先清除其入场动画，再让 #main-grid 统一渐变（避免中间卡片各自延迟）
				clearPageRegionAnimations();
				const mainGrid = document.getElementById('main-grid');
				if (mainGrid) {
					// @ts-ignore
					const currentLayout = window.__pendingLayoutMode || localStorage.getItem('postListLayout') || defaultPostListLayout;
					mainGrid.setAttribute('data-layout-mode', currentLayout);

					const rightSidebar = document.querySelector('.right-sidebar-container');
					if (rightSidebar) {
						if (currentLayout === 'grid') {
							rightSidebar.classList.add('hidden-in-grid-mode');
						} else {
							rightSidebar.classList.remove('hidden-in-grid-mode');
						}
					}

					// 关键：同时更新文章列表容器的CSS类
					const postListContainer = document.getElementById('post-list-container');
					if (postListContainer) {
						// 移除现有布局类
						postListContainer.classList.remove('list-mode', 'grid-mode');

						if (currentLayout === 'grid') {
							postListContainer.classList.add('grid-mode');
							postListContainer.classList.add('grid', 'grid-cols-1', 'lg:grid-cols-2', 'gap-6');
							postListContainer.classList.remove('flex', 'flex-col');
						} else {
							postListContainer.classList.add('list-mode');
							postListContainer.classList.add('flex', 'flex-col');
							postListContainer.classList.remove('grid', 'grid-cols-1', 'lg:grid-cols-2', 'gap-6');
						}
					}

					// 清除临时状态
					// @ts-ignore
					delete window.__pendingLayoutMode;
				}

				// 26.09.01 [3]：目标页为主页时触发全屏壁纸随机切换（F-02），新主页已开始渲染、渐变与新页淡入同步
				if (window.__pendingTargetHome && typeof window.__mizukiSwitchWallpaper === 'function') {
					window.__mizukiSwitchWallpaper();
				}
				delete window.__pendingTargetHome;
			});

			// 目标页布局状态：主页/非主页的磁贴显隐与网格列同步（swup 只替换容器内容，不更新 #main-grid 的类）
			// @ts-ignore
			window.swup.hooks.on('page:view', function() {
				clearPageRegionAnimations();
			});

			return true;
		}
		return false;
	}

	// 尝试立即设置，如果失败则延迟重试（swup 是 loadOnIdle 惰性初始化）
	if (!setupSwupLayoutSync()) {
		const checkSwup = setInterval(function() {
			if (setupSwupLayoutSync()) {
				clearInterval(checkSwup);
			}
		}, 50);

		setTimeout(function() {
			clearInterval(checkSwup);
		}, 4000);
	}
	
	// 支持 Swup 页面过渡
	// 26.08.30修改，内容为：swup 页面切换后重新应用简洁模式（simple-mode 类），避免切页后磁贴显示状态残留

	document.addEventListener('swup:page:view', function() {
		// 26.08.31修改，内容为：新页面节点插入后再次清除加载动画，避免跨页瞬间各自淡入（统一由 #main-grid 渐变）
		clearPageRegionAnimations();
		applyWallpaperMode();
		
		// 26.08.31修改，内容为：在Swup页面切换时重新应用简洁模式（默认常规模式）
		const simpleMode = localStorage.getItem('simpleMode');
		if (simpleMode === 'true') {
			document.body.classList.add('simple-mode');
		} else {
			document.body.classList.remove('simple-mode');
		}

		// 在Swup页面切换时也要重新应用布局模式
		requestAnimationFrame(function() {
			const mainGrid = document.getElementById('main-grid');
			if (mainGrid) {
				const savedLayout = localStorage.getItem('postListLayout');
				const currentLayout = savedLayout || defaultPostListLayout;
				mainGrid.setAttribute('data-layout-mode', currentLayout);
				
				if (currentLayout === 'grid') {
					const rightSidebar = document.querySelector('.right-sidebar-container');
					if (rightSidebar) {
						rightSidebar.classList.add('hidden-in-grid-mode');
					}
				} else {
					const rightSidebar = document.querySelector('.right-sidebar-container');
					if (rightSidebar) {
						rightSidebar.classList.remove('hidden-in-grid-mode');
					}
				}
			}
		});
	});
	// 在页面完全加载后，再次确认布局模式是否正确
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', function() {
			const mainGrid = document.getElementById('main-grid');
			if (mainGrid) {
				const savedLayout = localStorage.getItem('postListLayout');
				const currentLayout = savedLayout || defaultPostListLayout;
				mainGrid.setAttribute('data-layout-mode', currentLayout);
				
				if (currentLayout === 'grid') {
					const rightSidebar = document.querySelector('.right-sidebar-container');
					if (rightSidebar) {
						rightSidebar.classList.add('hidden-in-grid-mode');
					}
				}
			}
		});
	}
</script>

<!-- 全屏壁纸 - 始终渲染，通过 JS 控制显示隐藏 -->
<FullscreenWallpaper config={fullscreenWallpaperConfig} />

<!-- 全局图标加载器 -->
<IconifyLoader />

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<!-- 26.09.06：吸顶职责上移到 #top-row；#navbar-wrapper 回到 relative，宽度与文章宽度（--content-width）保持一致 -->
<!-- 26.09.14：吸顶由 sticky 改为 fixed —— 「所有页面导航栏始终位于顶部、下拉时不消失」。
     sticky 的问题：吸附位置取决于元素在文档流中的位置与自身高度，本行在 banner 模式被撑到
     ≈30vh，吸附后导航栏落在视口上方 ⇒ 滚动即整条消失，且各页面/模式表现不一致（用户报告）。
     fixed 与文档流彻底解耦：任何页面、任何壁纸模式、任何滚动位置都在视口顶部。
     原本由文档流让出的空间改由紧随其后的 #top-row-space 占位（高度与 --top-row-h 恒等），
     因此首屏布局与改动前逐像素一致，不会把首屏内容顶到导航栏下面。 -->
<div id="top-row" class="z-50 pointer-events-none fixed top-0 left-0 right-0 transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto" data-navbar-pinned={siteConfig.navbar?.pinned === false ? "false" : "true"}>
    <div id="navbar-wrapper" class="pointer-events-auto relative transition-all h-full">
        <Navbar></Navbar>
    </div>
</div>
<!-- #top-row 因 fixed 脱离文档流，这里补回等高的占位块，保证首屏排版不变 -->
<div id="top-row-space" class="w-full pointer-events-none" aria-hidden="true"></div>

<!-- Banner - 始终渲染，通过 JS 控制显示隐藏 -->
<div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden ${mobileNonHomeBannerClass}`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>

    {siteConfig.banner.carousel?.enable && ((bannerDesktopImages && Array.isArray(bannerDesktopImages) && bannerDesktopImages.length > 1) || (bannerImages.mobile && Array.isArray(bannerImages.mobile) && bannerImages.mobile.length > 1)) ? (
        <!-- Carousel mode for multiple images -->
        <div id="banner-carousel" class="relative h-full w-full">
            <ul class="carousel-list h-full w-full">
                {Math.max(
                    Array.isArray(bannerDesktopImages) ? bannerDesktopImages.length : 0,
                    Array.isArray(bannerImages.mobile) ? bannerImages.mobile.length : 0
                ) && Array.from({ length: Math.max(
                    Array.isArray(bannerDesktopImages) ? bannerDesktopImages.length : 0,
                    Array.isArray(bannerImages.mobile) ? bannerImages.mobile.length : 0
                ) }).map((_, index) => {
                    // 确保至少有一个平台有对应索引的图片
                    const hasDesktopImage = Array.isArray(bannerDesktopImages) && bannerDesktopImages[index];
                    const hasMobileImage = Array.isArray(bannerImages.mobile) && bannerImages.mobile[index];
                    
                    // 如果两个平台都没有对应索引的图片，跳过这个轮播项
                    if (!hasDesktopImage && !hasMobileImage) {
                        return null;
                    }
                    
                    return (
                        <li class={`carousel-item absolute inset-0 transition-all duration-500 ${index === 0 ? 'opacity-100 scale-100' : 'opacity-0 scale-110'}`}>
                            <!-- Mobile: use mobile-specific images -->
                            {hasMobileImage && (
                                <ImageWrapper 
                                    alt={`Mobile banner image ${index + 1}`} 
                                    class:list={["block md:hidden object-cover h-full w-full transition-transform duration-500 ease-out"]}
                                    src={Array.isArray(bannerImages.mobile) ? bannerImages.mobile[index] : (typeof bannerImages.mobile === 'string' ? bannerImages.mobile : '')} 
                                    position={siteConfig.banner.position}
                                    loading={index === 0 ? "eager" : "lazy"}
                                    
                                />
                            )}
                            <!-- Desktop/Tablet: use desktop-specific images -->
                            {hasDesktopImage && (
                                <ImageWrapper 
                                    alt={`Desktop banner image ${index + 1}`} 
                                    class:list={["hidden md:block object-cover h-full w-full transition-transform duration-500 ease-out"]}
                                    src={Array.isArray(bannerDesktopImages) ? bannerDesktopImages[index] : (typeof bannerDesktopImages === 'string' ? bannerDesktopImages : '')} 
                                    position={siteConfig.banner.position}
                                    loading={index === 0 ? "eager" : "lazy"}
                                />
                            )}
                        </li>
                    );
                }).filter(Boolean)}
            </ul>
        </div>
    ) : (
        <!-- Single image mode -->
        <div id="banner-single-container" class="relative h-full w-full">
            <script is:inline define:vars={{ desktopImages: bannerDesktopImages, mobileImages: bannerImages.mobile, position: siteConfig.banner.position }}>
                (function() {
                    const getRandomImage = (images, storageKey) => {
                        if (Array.isArray(images)) {
                            if (images.length === 0) return null;
                            if (images.length === 1) return images[0];
                            
                            const lastIndex = sessionStorage.getItem(storageKey);
                            let newIndex;
                            
                            do {
                                newIndex = Math.floor(Math.random() * images.length);
                            } while (newIndex === parseInt(lastIndex || '-1'));
                            
                            sessionStorage.setItem(storageKey, newIndex.toString());
                            return images[newIndex];
                        }
                        return images || null;
                    };
                    
                    const desktopSrc = getRandomImage(desktopImages, 'banner_desktop_index');
                    const mobileSrc = getRandomImage(mobileImages, 'banner_mobile_index');
                    
                    const container = document.getElementById('banner-single-container');
                    
                    if (mobileSrc) {
                        const mobileImg = document.createElement('img');
                        mobileImg.alt = 'Mobile banner image of the blog';
                        mobileImg.className = 'block md:hidden object-cover h-full w-full transition duration-700 opacity-100';
                        mobileImg.src = mobileSrc;
                        mobileImg.loading = 'eager';
                        mobileImg.dataset.position = position;
                        container.appendChild(mobileImg);
                    }
                    
                    if (desktopSrc) {
                        const desktopImg = document.createElement('img');
                        desktopImg.id = 'banner';
                        desktopImg.alt = 'Desktop banner image of the blog';
                        desktopImg.className = 'hidden md:block object-cover h-full w-full transition duration-700 opacity-100';
                        desktopImg.src = desktopSrc;
                        desktopImg.loading = 'eager';
                        desktopImg.dataset.position = position;
                        container.appendChild(desktopImg);
                    }
                })();
            </script>
        </div>
    )}
    
    <!-- Home page text overlay -->
    {siteConfig.banner.homeText?.enable && (
        <div class={`banner-text-overlay absolute inset-0 z-20 flex items-center justify-center ${!showHomeText ? 'hidden' : ''}`}>
            <div class="w-4/5 lg:w-3/4 text-center mb-0">
                <div class="flex flex-col">
                    {siteConfig.banner.homeText?.title && (
                        <h1 class="banner-title text-6xl lg:text-8xl text-white drop-shadow-lg mb-2 lg:mb-4">
                            {siteConfig.banner.homeText.title}
                        </h1>
                    )}
                    {siteConfig.banner.homeText?.subtitle && (
                        <h2 class="banner-subtitle text-xl lg:text-3xl text-white/90 drop-shadow-md">
                            <span class="inline-block min-h-[1.2em]">
                                {siteConfig.banner.homeText.typewriter?.enable ? (
                                    <TypewriterText 
                                        text={siteConfig.banner.homeText.subtitle}
                                        speed={siteConfig.banner.homeText.typewriter.speed}
                                        deleteSpeed={siteConfig.banner.homeText.typewriter.deleteSpeed}
                                        pauseTime={siteConfig.banner.homeText.typewriter.pauseTime}
                                    />
                                ) : (
                                    Array.isArray(siteConfig.banner.homeText.subtitle) 
                                        ? siteConfig.banner.homeText.subtitle[0] 
                                        : siteConfig.banner.homeText.subtitle
                                )}
                            </span>
                        </h2>
                    )}
                </div>
            </div>
        </div>
    )}
    
    <!-- Water waves effect -->
    {siteConfig.banner.waves?.enable && (
        <div class="waves absolute -bottom-[1px] h-[10vh] max-h-[9.375rem] min-h-[3.125rem] w-full md:h-[15vh]" id="header-waves" style="transform: translateZ(0); will-change: fill;">
            <svg
                class="waves"
                xmlns="http://www.w3.org/2000/svg"
                xmlns:xlink="http://www.w3.org/1999/xlink"
                viewBox="0 20 150 32"
                preserveAspectRatio="none"
                shape-rendering="auto"
                style="transform: translateZ(0); backface-visibility: hidden;"
            >
                <defs>
                    <path
                        id="gentle-wave"
                        d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v48h-352z"
                    >
                    </path>
                </defs>
                <g class="parallax" style="transform: translateZ(0);">
                    <use
                        xlink:href="#gentle-wave"
                        x="48"
                        y="0"
                        class="opacity-25 fill-[var(--page-bg)]"
                        style="animation-delay: -2s; animation-duration: 7s; will-change: transform;"
                    ></use>
                    <use
                        xlink:href="#gentle-wave"
                        x="48"
                        y="3"
                        class="opacity-50 fill-[var(--page-bg)]"
                        style="animation-delay: -3s; animation-duration: 10s; will-change: transform;"
                    ></use>
                    <use
                        xlink:href="#gentle-wave"
                        x="48"
                        y="5"
                        class="opacity-75 fill-[var(--page-bg)]"
                        style="animation-delay: -4s; animation-duration: 13s; will-change: transform;"
                    ></use>
                    <use
                        xlink:href="#gentle-wave"
                        x="48"
                        y="7"
                        class="fill-[var(--page-bg)]"
                        style="animation-delay: -5s; animation-duration: 20s; will-change: transform;"
                    ></use>
                </g>
            </svg>
        </div>
    )}
    

</div>

<!-- Main content -->
<div class={`absolute w-full z-30 pointer-events-none ${mobileNonHomeBannerClass ? 'mobile-main-no-banner' : ''} ${siteConfig.wallpaperMode.defaultMode === 'none' ? 'no-banner-layout' : ''}`} style={`top: ${finalMainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--content-width)] mx-auto pointer-events-auto">
