---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import path from "node:path";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/misc/Markdown.astro";
import SharePoster from "@components/misc/SharePoster.svelte";
import { Icon } from "astro-icon/components";
import katexStyleUrl from "katex/dist/katex.css?url";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import {
	licenseConfig,
	postViewConfig,
	profileConfig,
	shareConfig,
	siteConfig,
} from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";
import {
	getFileDirFromPath,
	getPostUrlBySlug,
} from "../../utils/url-utils";
import Encryptor from "../Encryptor.astro";
import ImageWrapper from "../misc/ImageWrapper.astro";
import License from "../misc/License.astro";
import PostMetadata from "../PostMeta.astro";
import "../../styles/paper.css";
import { createPostViewModel } from "../../lib/content/post-view-model";
import {
	getPostMedia,
	publicPostImageUrl,
} from "../../lib/media/post-media";

interface Props {
	entry: CollectionEntry<"posts">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const view = createPostViewModel(entry, {
	site: Astro.site,
	siteName: profileConfig.name,
	lang: siteConfig.lang,
});
const {
	canonicalUrl,
	imageMode,
	isEncrypted,
	hasCover,
	tags: tagLinks,
	jsonLd,
} = view;
const basePath = getFileDirFromPath(entry.filePath || "");
const coverMedia = hasCover ? getPostMedia(entry.data.image, basePath) : null;
const originalCoverUrl = publicPostImageUrl(entry.data.image, basePath);

let posterCoverUrl = entry.data.image;
if (entry.data.image) {
	const isLocal =
		!entry.data.image.startsWith("/") &&
		!entry.data.image.startsWith("http") &&
		!entry.data.image.startsWith("data:");
	if (isLocal) {
		const files = import.meta.glob<ImageMetadata>("../../**", {
			import: "default",
		});
		const normalized = path
			.normalize(path.join("../../", basePath, entry.data.image))
			.replace(/\\/g, "/");
		const file = files[normalized];
		if (file) {
			posterCoverUrl = (await file()).src;
		} else if (basePath.startsWith("public/")) {
			posterCoverUrl = `/${basePath.replace(/^public\//, "")}/${entry.data.image.replace(/^\.\//, "")}`;
		}
	}
}

---

<MainGridLayout
	title={entry.data.title}
	description={entry.data.description}
	lang={entry.data.lang}
	setOGTypeArticle
	postSlug={entry.id}
	headings={headings}
>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	/>
	<link slot="head" rel="canonical" href={canonicalUrl} />
	<link slot="head" rel="stylesheet" href={katexStyleUrl} />
	<script>
		import "../../scripts/right-sidebar-layout.js";
		import "../../scripts/paper-pagination.js";
	</script>

	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
		<article
			id="post-container"
			data-effect1-card
			data-display-model={entry.data.display_mode}
			data-title-position={entry.data.title_position}
			data-text-position={entry.data.text_position}
			class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full"
		>
			{
				hasCover &&
					siteConfig.showCoverInContent &&
					imageMode === "background" && (
						<div class="post-bg-cover" data-pagefind-ignore>
							<img
								src={coverMedia?.medium || posterCoverUrl}
								alt=""
								class="w-full h-full object-cover"
							/>
						</div>
					)
			}

			{
				hasCover &&
					siteConfig.showCoverInContent &&
					imageMode === "up" && (
						<div class="mb-8">
							<ImageWrapper
								id="post-cover"
								src={coverMedia?.medium || entry.data.image}
								basePath={basePath}
								originalSrc={originalCoverUrl}
								width={coverMedia?.width}
								height={coverMedia?.height}
								class="rounded-xl banner-container onload-animation"
								loading="eager"
							/>
						</div>
					)
			}

			<div class="relative onload-animation flex flex-wrap items-end justify-between gap-x-4 gap-y-2 mb-3">
				<h1
					data-pagefind-body
					data-pagefind-weight="10"
					data-pagefind-meta="title"
					class="transition font-bold text-3xl md:text-[2.25rem]/[2.75rem] text-black/90 dark:text-white/90 md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)] before:absolute before:top-[0.75rem] before:left-[-1.125rem]"
				>
					{entry.data.title}
				</h1>
				<div class="flex flex-col items-end gap-y-2">
					{tagLinks.length > 0 && (
						<div class="flex flex-wrap items-center justify-end gap-2">
							{tagLinks.map((tag) => (
								<a
									href={tag.searchUrl}
									aria-label={`Search posts tagged with ${tag.name}`}
									class="btn-regular h-6 text-xs px-2 rounded-lg whitespace-nowrap"
								>
									# {tag.name}
								</a>
							))}
						</div>
					)}
					<PostMetadata
						className=""
						published={entry.data.published}
						updated={entry.data.updated}
						id={entry.id}
						hideTags
					/>
				</div>
			</div>

			{
				hasCover &&
					siteConfig.showCoverInContent &&
					imageMode === "down" && (
						<div class="mb-8 mt-4">
							<ImageWrapper
								id="post-cover"
								src={coverMedia?.medium || entry.data.image}
								basePath={basePath}
								originalSrc={originalCoverUrl}
								width={coverMedia?.width}
								height={coverMedia?.height}
								class="rounded-xl banner-container onload-animation"
							/>
						</div>
					)
			}

			{
				isEncrypted ? (
					<Encryptor password={entry.data.password}>
						<Markdown class="mb-6 markdown-content onload-animation">
							<Content />
						</Markdown>
					</Encryptor>
				) : (
					<>
						<Markdown class="mb-6 markdown-content onload-animation">
							<Content />
						</Markdown>
						{licenseConfig.enable && postViewConfig.showLicense && (
							<License
								title={entry.data.title}
								id={entry.id}
								pubDate={entry.data.published}
								author={entry.data.author}
								sourceLink={entry.data.sourceLink}
								licenseName={entry.data.licenseName}
								licenseUrl={entry.data.licenseUrl}
								class="mb-6 rounded-xl license-container onload-animation"
							/>
						)}
					</>
				)
			}

			{
				shareConfig.enable && (
					<div
						id="share-component"
						class:list={[
							"p-6 bg-[var(--license-block-bg)] rounded-xl mb-6 onload-animation",
							{ "encrypted-hidden": isEncrypted },
						]}
					>
						<div class="flex flex-col sm:flex-row items-center justify-between gap-4">
							<div class="flex items-center gap-3 flex-1">
								<div class="flex items-center justify-center h-12 w-12 rounded-lg bg-[var(--enter-btn-bg)]">
									<Icon
										name="material-symbols:share"
										class="text-3xl text-[var(--primary)]"
									/>
								</div>
								<div class="flex flex-col gap-1">
									<div class="text-black/75 dark:text-white/75">
										{i18n(I18nKey.shareOnSocial)}
									</div>
									<p class="text-[0.8rem] leading-tight text-black/75 dark:text-white/75">
										{i18n(I18nKey.shareOnSocialDescription)}
									</p>
								</div>
							</div>
							<SharePoster
								client:load
								title={entry.data.title}
								author={entry.data.author || profileConfig.name}
								description={entry.data.description || ""}
								pubDate={formatDateToYYYYMMDD(entry.data.published)}
								coverImage={posterCoverUrl}
								url={canonicalUrl}
								siteTitle={siteConfig.title}
								avatar={profileConfig.avatar}
							/>
						</div>
					</div>
				)
			}
		</article>
	</div>

	<Comment post={entry} />

	{
		postViewConfig.showPrevNext && entry.data.active !== false && (
			<div class="flex flex-col md:flex-row justify-between mb-4 gap-4">
				{entry.data.nextSlug && (
					<a
						href={getPostUrlBySlug(entry.data.nextSlug)}
						class="btn-card rounded-2xl w-full min-h-[3.75rem] px-4 flex items-center gap-4"
					>
						<Icon name="material-symbols:chevron-left-rounded" class="text-2xl text-[var(--primary)]" />
						<span>{entry.data.nextTitle}</span>
					</a>
				)}
				{entry.data.prevSlug && (
					<a
						href={getPostUrlBySlug(entry.data.prevSlug)}
						class="btn-card rounded-2xl w-full min-h-[3.75rem] px-4 flex items-center justify-end gap-4"
					>
						<span>{entry.data.prevTitle}</span>
						<Icon name="material-symbols:chevron-right-rounded" class="text-2xl text-[var(--primary)]" />
					</a>
				)}
			</div>
		)
	}
</MainGridLayout>

<style>
	.post-bg-cover {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		opacity: 0.2;
		transition: opacity 0.3s ease;
	}
	:global(body.simple-mode .post-bg-cover) {
		opacity: 0.14;
	}
</style>
