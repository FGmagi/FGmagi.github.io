    }
}

/* 简洁模式：隐藏左右磁贴 */
:global(body.simple-mode .home-sidebar),
:global(body.simple-mode .home-right-sidebar) {
    display: none !important;
}

/* 简洁模式：主内容区占满整行，与上方导航栏等宽居中 */
@media (min-width: 768px) {
