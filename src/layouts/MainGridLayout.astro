<!-- 侧边栏TOC模式 -->
{siteConfig.toc.enable && isSidebarTOC && headings.length > 0 && (
    <script is:inline>
        /* 解析期置位：让 rail 在首帧即 display:block，与卡片同帧起跑（避免首载偏移）。
           门槛必须与 src/scripts/toc-layout.js 的桌面门**同源**：
             wideEnough ⇔ documentElement.clientWidth ≥ 88 × f，
             f = 当前根字号（pageScaling 会写 <html> font-size）。
           ⚠ 不能用 matchMedia('(min-width: 88rem)')：媒体查询里的 rem 恒按初始 16px 解析
             （不受 pageScaling 的 <html> font-size 影响）⇒ 固定等价 1408px，而 JS 侧在
             非触摸横屏（f≈13.6px）只需 ≈1197px，于是 viewport 1281–1407 会出现
             「JS 判 desktop、此处未置位」的缺口带（用户窗口 1280–1536 正好覆盖它）。
           ⚠ 读实际根字号是可行的：pageScaling 的 adjustPageScale() 在 Layout.astro 的
             <head> 里以**经典同步 inline 脚本**（is:inline + define:vars，无 type=module）
             立即执行一次，早于本文档体中的本脚本，故此处 getComputedStyle 已能读到。
           ⚠ 安全方向：本门与 JS 门**恒等**（同一公式、同一 f 含义），不会出现
             「预置 desktop 但 JS 判 narrow」的闪现；若将来改窄本门需重新论证。
             改动 toc-layout.js 的门槛公式时，必须同步改这里。 */
        const f = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
        if (document.documentElement.clientWidth >= 88 * f)
            document.documentElement.setAttribute('data-toc-layout', 'desktop');
    </script>
)}
<div id="toc-swup-region">
