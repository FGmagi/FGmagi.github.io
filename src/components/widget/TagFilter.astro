---
import { tagFilterConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { getTagList } from "../../utils/content-utils";
import { widgetManager } from "../../utils/widget-manager";
import WidgetLayout from "./WidgetLayout.astro";

const tags = await getTagList();
const showCount = tagFilterConfig.showCount === true;

const COLLAPSED_HEIGHT = "7.5rem";

// 与 Categories/Tags 一致：通过 widget-manager 读取折叠配置（collapseThreshold）
const tagFilterComponent = widgetManager
	.getConfig()
	.properties.find((p) => p.type === "tag-filter");
const isCollapsed = tagFilterComponent
	? widgetManager.isCollapsed(tagFilterComponent, tags.length)
	: false;

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

{tags.length > 0 && (
	<WidgetLayout
		name={i18n(I18nKey.tagFilter)}
		id="tag-filter"
		isCollapsed={isCollapsed}
		collapsedHeight={COLLAPSED_HEIGHT}
		class={className}
		style={style}
	>
		<div class="tag-filter-list" data-tag-filter-root>
			{
				tags.map((t) => {
					const label = t.name.trim();
					const key = label.toLowerCase();
					return (
						<button
							type="button"
							class="tag-filter-chip btn-regular h-6 text-xs px-2 rounded-lg"
							data-tag={key}
							aria-pressed="false"
						>
							<span class="tag-filter-label max-w-full truncate">
								{label}{showCount && `: ${t.count}`}
							</span>
						</button>
					);
				})
			}
			<span class="tag-filter-filler" aria-hidden="true"></span>
		</div>
	</WidgetLayout>
)}

<style>



	.tag-filter-list {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
	}
	.tag-filter-chip {
		flex: 0 1 auto;
		max-width: 100%;
		cursor: pointer;
	}
	.tag-filter-filler {
		flex: 1 1 0;
		min-width: 0;
		height: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.tag-filter-chip.active,
	.tag-filter-chip[aria-pressed="true"] {
		background: var(--primary);
		color: #fff;
	}
	.tag-filter-chip.active:hover,
	.tag-filter-chip[aria-pressed="true"]:hover {
		background: var(--primary);
		color: #fff;
	}
</style>

<script is:inline>
	(function () {
		var root = document.querySelector('[data-tag-filter-root]');
		if (!root) return;

		function getActiveTags() {
			if (!window.__tagFilterActive) window.__tagFilterActive = new Set();
			return window.__tagFilterActive;
		}

		function getSearchTerm() {
			var input = document.querySelector(
				'.home-search-bar .post-search-input',
			);
			return input && input.value
				? input.value.trim().toLowerCase()
				: '';
		}

		function applyTagFilter(animate) {
			var container = document.getElementById('post-list-container');
			if (!container) return;
			var active = getActiveTags();
			var searchTerm = getSearchTerm();
			var cards = container.querySelectorAll(
				':scope > [data-effect1-card]',
			);
			var pagination = document.querySelector('[data-page-pagination]');
			var desired = new Map();
			if (animate === false && active.size === 0 && !searchTerm) {
				cards.forEach(function (card) {
					card.classList.remove(
						'effect2-card',
						'effect2-hidden',
						'effect2-hiding',
						'effect2-entering',
						'effect2-revealing',
						'effect2-moving',
					);
					var next = card.nextElementSibling;
					if (next && next.classList.contains('post-card-divider')) {
						next.style.display = '';
					}
				});
				return;
			}
			for (var i = 0; i < cards.length; i++) {
				var card = cards[i];
				var tags = (card.getAttribute('data-tags') || '').split(/\s+/);
				var tagVisible = active.size === 0;
				if (!tagVisible) {
					for (var j = 0; j < tags.length; j++) {
						if (tags[j] && active.has(tags[j])) {
							tagVisible = true;
							break;
						}
					}
				}
				var searchText =
					(card.getAttribute('data-search-text') || '').toLowerCase();
				var searchVisible =
					!searchTerm || searchText.indexOf(searchTerm) >= 0;
				var visible = tagVisible && searchVisible;
				desired.set(card, visible);
			}

			if (window.CardFilter) {
				window.CardFilter.applyGroup(
					cards,
					function (card) {
						return desired.get(card) === true;
					},
					{
						group: container,
						layoutContainer: container,
						moveAlong: pagination,
						animate: animate !== false,
						measureLayout: function () {
							var changedDividers = [];
							cards.forEach(function (card) {
								var next = card.nextElementSibling;
								if (!next || !next.classList.contains('post-card-divider')) {
									return;
								}
								changedDividers.push([next, next.style.display]);
								next.style.display = desired.get(card) ? '' : 'none';
							});
							return function () {
								changedDividers.forEach(function (entry) {
									entry[0].style.display = entry[1];
								});
							};
						},
						afterHide: function (hiddenCards) {
							hiddenCards.forEach(function (card) {
								var next = card.nextElementSibling;
								if (next && next.classList.contains('post-card-divider')) {
									next.style.display = 'none';
								}
							});
						},
						afterReveal: function (shownCards) {
							shownCards.forEach(function (card) {
								var next = card.nextElementSibling;
								if (next && next.classList.contains('post-card-divider')) {
									next.style.display = '';
								}
							});
						},
					},
				);
			} else {
				cards.forEach(function (card) {
					card.style.display = desired.get(card) ? '' : 'none';
					var next = card.nextElementSibling;
					if (next && next.classList.contains('post-card-divider')) {
						next.style.display = desired.get(card) ? '' : 'none';
					}
				});
			}
		}

		function clearTagFilter() {
			getActiveTags().clear();
			document
				.querySelectorAll('[data-tag-filter-root] .tag-filter-chip')
				.forEach(function (chip) {
					chip.classList.remove('active');
					chip.setAttribute('aria-pressed', 'false');
				});
			var container = document.getElementById('post-list-container');
			if (
				!container ||
				document.body.classList.contains('swup-leaving') ||
				document.documentElement.classList.contains('is-animating')
			) {
				// 只清理筛选状态，不改即将离场的主页 DOM，避免切页瞬间全部文章闪回。
				return;
			}
			// 复位不做逐卡动画：切页/跳转本身已有入场动画，叠在一起会显得拖沓
			applyTagFilter(false);
		}

		function bindTagFilterChips() {
			document
				.querySelectorAll('[data-tag-filter-root] .tag-filter-chip')
				.forEach(function (chip) {
					chip.addEventListener('click', function () {
						var tag = (chip.getAttribute('data-tag') || '').trim();
						if (!tag) return;
						var active = getActiveTags();
						if (chip.classList.contains('active')) {
							chip.classList.remove('active');
							chip.setAttribute('aria-pressed', 'false');
							active.delete(tag);
						} else {
							chip.classList.add('active');
							chip.setAttribute('aria-pressed', 'true');
							active.add(tag);
						}
						applyTagFilter(true);
					});
				});
		}
		bindTagFilterChips();

		function syncTagFilterFiller() {
			var list = root.querySelectorAll('.tag-filter-chip');
			var filler = root.querySelector('.tag-filter-filler');
			if (!filler || list.length === 0) return;
			var last = list[list.length - 1];
			filler.style.display = '';
			// 用垂直重叠判断同一 flex 行（filler 高度为 0 且 align-items:center，offsetTop 会差半个行高）
			var lastRect = last.getBoundingClientRect();
			var fillerRect = filler.getBoundingClientRect();
			if (
				fillerRect.top >= lastRect.bottom ||
				fillerRect.bottom <= lastRect.top
			) {
				filler.style.display = 'none';
			}
		}
		function scheduleFillerSync() {
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', function () {
					requestAnimationFrame(syncTagFilterFiller);
				});
			} else {
				requestAnimationFrame(syncTagFilterFiller);
			}
		}
		scheduleFillerSync();

		if (!window.__tagFilterBound) {
			window.__tagFilterBound = true;

			document.addEventListener('click', function (e) {
				var anchor =
					e.target && e.target.closest
						? e.target.closest('a[href]')
						: null;
				if (!anchor) return;
				var href = anchor.getAttribute('href') || '';
				if (
					href.charAt(0) === '#' ||
					href.indexOf('http') === 0 ||
					href.indexOf('//') === 0 ||
					anchor.getAttribute('target') === '_blank'
				) {
					return;
				}
				try {
					if (
						new URL(anchor.href, window.location.origin).pathname ===
						window.location.pathname
					) {
						clearTagFilter();
					}
				} catch (err) {
					/* 忽略无法解析的链接 */
				}
			});

			document.addEventListener('swup:page:view', clearTagFilter);
			window.addEventListener('popstate', clearTagFilter);
			window.addEventListener('fgmagi:home-search', function () {
				applyTagFilter(true);
			});
			window.addEventListener('resize', function () {
				requestAnimationFrame(syncTagFilterFiller);
			});

			var swupTries = 0;
			function tryBindSwupClear() {
				if (window.swup && window.swup.hooks) {
					window.swup.hooks.on('content:replace', clearTagFilter);
					return true;
				}
				if (swupTries < 20) {
					swupTries++;
					setTimeout(tryBindSwupClear, 100);
				}
				return false;
			}
			tryBindSwupClear();
		}
	})();
</script>
