---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "eager" | "lazy";
	originalSrc?: string;
	srcset?: string;
	sizes?: string;
	width?: number;
	height?: number;
	hideOverlay?: boolean;
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	loading = "lazy",
	hideOverlay = false,
	originalSrc,
	srcset,
	sizes,
	width,
	height,
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img: ImageMetadata | undefined;
let publicImagePath = "";
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		// public/ 目录下的图片（如 /data/posts/xxx/image/cover.jpg）不会被 glob 匹配，
		// 但构建时会原样复制到 dist，直接构造 public URL 即可
		if (basePath.startsWith("public/")) {
			publicImagePath = url(
				`/${basePath.replace(/^public\//, "")}/${src.replace(/^\.\//, "")}`,
			);
		} else {
			console.error(
				`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
			);
		}
	} else {
		img = await file();
	}
}

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;

// 检查是否是 Bilibili 图片
const isBilibiliImage = !isLocal && src.includes("hdslb.com");
// 对于外部图片（特别是Bilibili），需要设置referrerpolicy避免403错误
const referrerPolicy = !isLocal && isBilibiliImage ? "no-referrer" : undefined;
---
<div
    id={id}
    class:list={[className, "image-shell overflow-hidden relative"]}
    data-image-shell
    data-image-state="idle"
>
    {!hideOverlay && (
        <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    )}
    {isLocal && img && <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading} width={width} height={height} data-image-fallback="1" data-original-src={originalSrc || publicImagePath || src}/>}
    {isLocal && !img && publicImagePath && <img src={publicImagePath} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading} width={width} height={height} srcset={srcset} sizes={sizes} data-image-fallback="1" data-original-src={originalSrc || publicImagePath}/>}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading} width={width} height={height} srcset={srcset} sizes={sizes} referrerpolicy={referrerPolicy} crossorigin={isBilibiliImage ? "anonymous" : undefined} data-image-fallback="1" data-original-src={originalSrc || src}/>}
    <span class="image-error-label" aria-hidden="true">图片不可用</span>
</div>

<style>
    .image-shell {
        background: linear-gradient(
            135deg,
            color-mix(in oklab, var(--card-bg), black 6%),
            var(--card-bg)
        );
    }
    .image-shell.is-error .image-error-label {
        display: flex;
    }
    .image-error-label {
        position: absolute;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        color: var(--text-50, rgb(100 116 139));
        font-size: 0.75rem;
    }
    .image-shell.is-error img {
        opacity: 0;
    }
    .image-shell img {
        transition: opacity var(--mo-base, 220ms) ease;
    }
    :global(html[data-motion-image-reveal="off"]) .image-shell img {
        transition: none;
    }
</style>
