---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import { getFileDirFromPath, getTagUrl, getPostUrl } from "@/utils/url-utils";
import { siteConfig } from "../config";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	style?: string;
}

const { entry, style } = Astro.props;
const className = Astro.props.class;

// 26.08.30修改，内容为：卡片改为悬停整体变暗10%、移除封面悬停箭头与标题变色、无标签不渲染、无说明时显示正文首行半宽省略号、日期/字数/分类移至标题同行靠右底对齐、简洁模式隐藏封面
const {
	title,
	published,
	updated,
	tags,
	category,
	image,
	description,
	pinned,
} = entry.data;

const url = getPostUrl(entry);
const hasCover = image !== undefined && image !== null && image !== "";
const coverWidth = "28%";

const { remarkPluginFrontmatter } = await render(entry);
---

<div
	class:list={[
		"card-base group flex flex-col-reverse md:flex-col w-full rounded-[var(--radius-large)] overflow-hidden relative",
		className,
	]}
	style={style}
>
	<div class="absolute inset-0 z-30 pointer-events-none transition rounded-[var(--radius-large)] bg-black/10 opacity-0 group-hover:opacity-100"></div>
	<!-- 26.08.31修改，内容为：整卡可点击跳转——覆盖全卡的链接锚点，点击卡片任意位置进入文章 -->
	<a href={url} aria-label={title} tabindex="-1" class="absolute inset-0 z-10 rounded-[var(--radius-large)]"></a>
	<!-- 26.09.01修改，内容为：内容区垂直内边距改为 pt-4 md:pt-5 pb-4（移动端 3rem->2rem、桌面端 3.25rem->2.25rem，各恰减 1rem），字体大小不变；空白卡槽位高度已在 PostPage.astro 同步校准 -->
	<div
		class:list={[
			"post-card-content pl-6 md:pl-9 pr-6 md:pr-[0.667rem] pt-4 md:pt-5 pb-4 relative",
			{
				"w-full md:w-[calc(100%_-_3.25rem_-_0.75rem)]": !hasCover,
				"w-full md:w-[calc(100%_-_var(--coverWidth)_-_0.75rem)]": hasCover,
			},
		]}
	>
		<div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-2 mb-3">
			<a
				href={url}
				class="transition min-w-0 flex-1 block font-bold text-3xl text-90
				before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
				before:absolute
				before:top-[2.1875rem] before:left-[1.125rem] before:hidden md:before:block"
			>
				{
					pinned && (
						<Icon
							name="mdi:pin"
							class="inline text-[var(--primary)] text-2xl mr-2 -translate-y-0.5"
						/>
					)
				}
				{title}
			</a>

			<PostMetadata
				published={published}
				updated={updated}
				tags={tags}
				category={category || ""}
				hideTagsForMobile={true}
				hideUpdateDate={true}
				className="shrink-0 post-card-meta mr-4"
				showOnlyBasicMeta={true}
				words={remarkPluginFrontmatter.words}
				showWordCount={true}
				hideUncategorized
				hideMetaIcons
			/>
		</div>

		<div
			class:list={[
				"transition text-75 mt-[0.3rem] mb-[0.575rem] pr-4",
				description
					? "line-clamp-2 md:line-clamp-1"
					: "line-clamp-1 max-w-[50%]",
			]}
		>
			{description || remarkPluginFrontmatter.excerpt}
		</div>

		{
			tags && tags.length > 0 && (
				<div class="flex flex-wrap gap-2 mt-2">
					{tags.map((tag) => (
						<a
							href={getTagUrl(tag)}
							class:list={[
								"relative z-20",
								siteConfig.tagStyle?.useNewStyle
									? "link-lg transition text-50 text-xs font-medium px-2 py-1 rounded-lg hover:text-[var(--primary)] dark:hover:text-[var(--primary)] active:text-[var(--primary)] dark:active:text-[var(--primary)] group/tag whitespace-nowrap"
									: "btn-regular h-6 text-xs px-2 rounded-lg",
							]}
							aria-label={`View all posts tagged with ${tag.trim()}`}
						>
							<span class="transition-transform group-hover/tag:translate-x-0.5">
								# {tag.trim()}
							</span>
						</a>
					))}
				</div>
			)
		}
	</div>

	{
		hasCover && (
			<a
				href={url}
				aria-label={title}
				class:list={[
					"post-cover-link",
					"max-h-[20vh] md:max-h-none mx-4 mt-4 -mb-2 md:mb-0 md:mx-0 md:mt-0",
					"md:w-[var(--coverWidth)] relative md:absolute md:top-[12.5%] md:bottom-[12.5%] md:right-3 rounded-xl overflow-hidden active:scale-95",
				]}
			>
				<ImageWrapper
					src={image}
					basePath={getFileDirFromPath(entry.filePath || "")}
					alt="Cover Image of the Post"
					class="w-full h-full"
					hideOverlay
				/>
			</a>
		)
	}

	{
		!hasCover && (
			<a
				href={url}
				aria-label={title}
				class="!hidden md:!flex btn-regular w-[3.25rem]
         absolute right-3 top-3 bottom-3 rounded-xl bg-[var(--enter-btn-bg)]
         hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] active:scale-95
        "
			>
				<Icon
					name="material-symbols:chevron-right-rounded"
					class="transition text-[var(--primary)] text-4xl mx-auto"
				/>
			</a>
		)
	}
</div>
<div
	class="transition border-t-[1px] border-dashed mx-6 border-black/10 dark:border-white/[0.15] last:border-t-0 md:hidden"
>
</div>

<style define:vars={{ coverWidth }}>
	/* 26.08.30修改，内容为：简洁模式下主页不渲染封面图，内容区恢复全宽 */
	:global(body.simple-mode .post-cover-link) {
		display: none !important;
	}
	:global(body.simple-mode .post-card-content) {
		width: 100% !important;
		padding-right: 2rem !important;
	}
	/* 26.08.31修改，内容为：竖图居中 contain（左右透明边距），横图填满封面 */
	:global(.post-cover-link img.cover-portrait) {
		object-fit: contain !important;
	}
	/* 26.08.31修改，内容为：常规模式下隐藏字数统计（简洁模式保留），日期/分类保持在封面左侧 2rem 处 */
	:global(body:not(.simple-mode) .post-card-meta .meta-words) {
		display: none !important;
	}
</style>
