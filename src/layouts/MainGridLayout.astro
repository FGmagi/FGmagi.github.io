            {/* 26.08.30修改，内容为：左右磁贴容器改为始终渲染（带 home-sidebar/home-right-sidebar 类），由 CSS 按首页/简洁模式控制显隐，供 swup 切换时同步 */}
            {/* 侧边栏和主内容区域容器 */}

            {/* 侧边栏和主内容区域容器 */}
            <div id="sidebar-swup-container" class="contents">
                <SideBar class={`${sidebarClass} home-sidebar`} headings={headings}></SideBar>

                <div class={`right-sidebar-container home-right-sidebar ${rightSidebarClass}`}>
