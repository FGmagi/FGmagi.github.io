---
import type { CollectionEntry } from "astro:content";
import PostView from "../../components/posts/PostView.astro";
import { getSortedPosts } from "../../utils/content-utils";
import {
	initPostIdMap,
} from "../../utils/permalink-utils";
import { removeFileExtension } from "../../utils/url-utils";

type PathProps = { entry: CollectionEntry<"posts"> };

export async function getStaticPaths() {
	const entries = await getSortedPosts();
	initPostIdMap(entries);
	const paths: Array<{ params: { slug: string }; props: PathProps }> = [];
	const seen = new Set<string>();
	for (const entry of entries) {
		const slug = removeFileExtension(entry.id);
		if (!seen.has(slug)) {
			seen.add(slug);
			paths.push({ params: { slug }, props: { entry } });
		}
		if (entry.data.alias) {
			const alias = entry.data.alias
				.replace(/^\/+/, "")
				.replace(/\/+$/, "")
				.replace(/^posts\//, "");
			if (alias && !seen.has(alias)) {
				seen.add(alias);
				paths.push({ params: { slug: alias }, props: { entry } });
			}
		}
	}
	return paths;
}

const { entry } = Astro.props as PathProps;
---

<PostView entry={entry} />
