---
import {
	motionSettingsConfig,
	scaleMotionDuration,
	siteConfig,
} from "../../config";
import type { FullscreenWallpaperConfig } from "../../types/config";

interface Props {
	config: FullscreenWallpaperConfig;
	className?: string;
}

const { config, className } = Astro.props;

function normalizeAssetPath(src: string): string {
	if (!src) return src;
	if (/^(https?:)?\/\//i.test(src)) return src;
	let value = src.trim();
	if (value.startsWith("public/")) value = value.slice("public/".length);
	if (!value.startsWith("/")) value = `/${value}`;
	return value;
}

async function getImageSources() {
	let source = config.src;
	if (siteConfig.banner.imageApi?.enable && siteConfig.banner.imageApi.url) {
		try {
			const response = await fetch(siteConfig.banner.imageApi.url);
			const lines = (await response.text())
				.split("\n")
				.map((line) => line.trim())
				.filter(Boolean);
			if (lines.length) source = lines;
		} catch {
			// The local configuration remains the fallback.
		}
	}

	const toArray = (value: string | string[] | undefined): string[] =>
		Array.isArray(value) ? value : typeof value === "string" ? [value] : [];
	if (source && typeof source === "object" && !Array.isArray(source)) {
		const desktop = toArray(source.desktop);
		const mobile = toArray(source.mobile);
		return {
			desktop: (desktop.length ? desktop : mobile).map(normalizeAssetPath),
			mobile: (mobile.length ? mobile : desktop).map(normalizeAssetPath),
		};
	}
	const all = toArray(source as string | string[]).map(normalizeAssetPath);
	return { desktop: all, mobile: all };
}

const imageSources = await getImageSources();
if (!imageSources.desktop.length && !imageSources.mobile.length) return null;

const interval = Math.max(30, Number(config.carousel?.interval) || 300);
const carouselEnabled =
	config.carousel?.enable === true &&
	Math.max(imageSources.desktop.length, imageSources.mobile.length) > 1;
const position = config.position || "center";
const zIndex = config.zIndex ?? -1;
const opacity = config.opacity ?? 0.28;
const blur = config.blur ?? 0;
const positionClass = {
	top: "object-top",
	center: "object-center",
	bottom: "object-bottom",
}[position];
const bannerModeEnabled = siteConfig.wallpaperMode.enableBannerMode !== false;
const crossfadeDuration = scaleMotionDuration(
	motionSettingsConfig.features.wallpaperCrossfade.duration,
);
const kenBurnsDuration = scaleMotionDuration(
	motionSettingsConfig.features.wallpaperKenBurns.duration,
);
const groups = [
	{
		key: "desktop",
		sources: imageSources.desktop,
		className: "hidden md:block",
	},
	{
		key: "mobile",
		sources: imageSources.mobile,
		className: "block md:hidden",
	},
];
---

<div
	class:list={[
		"fixed inset-0 w-full h-full overflow-hidden pointer-events-none wallpaper-container",
		className,
	]}
	style={`z-index:${zIndex};opacity:${opacity};filter:blur(${blur}px);transform:translateZ(0);--wp-ken-burns-duration:${kenBurnsDuration}ms`}
	data-fullscreen-wallpaper
	data-wp-desktop-count={imageSources.desktop.length}
	data-wp-mobile-count={imageSources.mobile.length}
	data-wp-carousel={carouselEnabled ? "true" : "false"}
	data-wp-interval={interval}
>
	<script
		is:inline
		define:vars={{ bannerModeEnabled }}
	>
		(function () {
			const root = document.currentScript?.parentElement;
			if (!root) return;
			let mode = localStorage.getItem("wallpaperMode") || "fullscreen";
			if (!bannerModeEnabled && mode === "banner") {
				mode = "fullscreen";
				localStorage.setItem("wallpaperMode", mode);
			}
			if (mode !== "fullscreen") root.style.display = "none";
		})();
	</script>

	{
		groups.map((group) =>
			group.sources.length > 0 ? (
				<div
					class={`${group.className} w-full h-full relative`}
					data-wp-group={group.key}
					data-wp-active-slot="a"
				>
					<img
						data-wp-slot="a"
						alt=""
						aria-hidden="true"
						class:list={[
							"wp-ken-burns absolute inset-0 w-full h-full object-cover opacity-100",
							positionClass,
						]}
						decoding="async"
						fetchpriority="high"
						data-fg-ken-burns
					/>
					<img
						data-wp-slot="b"
						alt=""
						aria-hidden="true"
						class:list={[
							"wp-ken-burns absolute inset-0 w-full h-full object-cover opacity-0",
							positionClass,
						]}
						decoding="async"
						data-fg-ken-burns
					/>
				</div>
			) : null,
		)
	}

	<script
		is:inline
		define:vars={{
			desktopImages: imageSources.desktop,
			mobileImages: imageSources.mobile,
			carouselEnabled,
			interval,
			bannerModeEnabled,
			crossfadeDuration,
		}}
	>
		(function () {
			const root = document.querySelector("[data-fullscreen-wallpaper]");
			if (!root || window.__fgWallpaperReady) return;
			window.__fgWallpaperReady = true;

			const INDEX_KEY = "mizuki_wallpaper_index";
			const LAST_SWITCH_KEY = "mizuki_wallpaper_last_switch";
			const lists = { desktop: desktopImages || [], mobile: mobileImages || [] };
			const media = window.matchMedia("(min-width: 768px)");
			let timer = null;
			let switching = false;
			let destroyed = false;
			let jobToken = 0;

			const mode = () => {
				let value = localStorage.getItem("wallpaperMode") || "fullscreen";
				if (!bannerModeEnabled && value === "banner") {
					value = "fullscreen";
					localStorage.setItem("wallpaperMode", value);
				}
				return value;
			};
			const groupName = () => (media.matches ? "desktop" : "mobile");
			const getGroup = (name = groupName()) =>
				root.querySelector(`[data-wp-group="${name}"]`);
			const getList = (name = groupName()) => {
				const primary = lists[name] || [];
				return primary.length ? primary : lists[name === "desktop" ? "mobile" : "desktop"] || [];
			};
			const getSlot = (group, name) =>
				group?.querySelector(`[data-wp-slot="${name}"]`) || null;
			const activeName = (group) =>
				group?.dataset.wpActiveSlot === "b" ? "b" : "a";
			const currentIndex = (length) => {
				const saved = Number.parseInt(sessionStorage.getItem(INDEX_KEY) || "0", 10);
				return Number.isFinite(saved) && saved >= 0 && saved < length ? saved : 0;
			};
			const readLastSwitch = () => {
				const value = Number.parseInt(sessionStorage.getItem(LAST_SWITCH_KEY) || "0", 10);
				return Number.isFinite(value) ? value : 0;
			};
			const clearTimer = () => {
				if (timer) window.clearTimeout(timer);
				timer = null;
				root.dataset.wpAutoplay = "off";
			};
			const canAutoplay = () =>
				carouselEnabled &&
				mode() === "fullscreen" &&
				!document.hidden &&
				document.documentElement.dataset.motionBannerAutoPlay !== "off" &&
				document.documentElement.dataset.reducedMotion !== "true";

			function activateInitial(group = getGroup()) {
				if (!group) return;
				const list = getList(group.dataset.wpGroup);
				const slot = getSlot(group, activeName(group));
				if (!slot || !list.length || slot.getAttribute("src")) return;
				slot.src = list[currentIndex(list.length)];
				group.dataset.wpActiveSlot = activeName(group);
			}

			function waitForImage(image) {
				return new Promise((resolve) => {
					if (image.complete && image.naturalWidth > 0) {
						resolve(true);
						return;
					}
					const done = (ok) => {
						image.removeEventListener("load", onLoad);
						image.removeEventListener("error", onError);
						resolve(ok);
					};
					const onLoad = () => done(true);
					const onError = () => done(false);
					image.addEventListener("load", onLoad, { once: true });
					image.addEventListener("error", onError, { once: true });
				});
			}

			function nextPaint() {
				return new Promise((resolve) => {
					let settled = false;
					const finish = () => {
						if (settled) return;
						settled = true;
						resolve();
					};
					if (typeof requestAnimationFrame === "function") {
						requestAnimationFrame(finish);
					}
					window.setTimeout(finish, 32);
				});
			}

			function schedule() {
				clearTimer();
				if (destroyed || !canAutoplay()) return;
				const last = readLastSwitch();
				const elapsed = last ? Date.now() - last : interval * 1000;
				const remaining = Math.max(1000, interval * 1000 - elapsed);
				timer = window.setTimeout(() => {
					timer = null;
					root.dataset.wpAutoplay = "switching";
					void switchWallpaper(false, true);
				}, remaining);
				root.dataset.wpAutoplay = "scheduled";
			}

			async function switchWallpaper(force = false, automatic = false) {
				if (!carouselEnabled || switching || destroyed) return false;
				if (mode() !== "fullscreen") return false;
				if (!force && !automatic) {
					const last = readLastSwitch();
					if (last && Date.now() - last < interval * 1000) return false;
				}

				const group = getGroup();
				const list = getList();
				if (!group || list.length <= 1) return false;
				const activeSlot = activeName(group);
				const bufferSlot = activeSlot === "a" ? "b" : "a";
				const active = getSlot(group, activeSlot);
				const buffer = getSlot(group, bufferSlot);
				if (!active || !buffer) return false;

				const current = currentIndex(list.length);
				let next = (current + 1) % list.length;
				if (list.length > 2) {
					next = Math.floor(Math.random() * list.length);
					if (next === current) next = (next + 1) % list.length;
				}

				switching = true;
				const token = ++jobToken;
				clearTimer();
				buffer.style.transition = "none";
				buffer.style.opacity = "0";
				buffer.style.zIndex = "2";
				buffer.style.transform = "translateZ(0)";
				const loadedPromise = waitForImage(buffer);
				buffer.src = list[next];
				const loaded = await loadedPromise;
				if (!loaded || destroyed || token !== jobToken || mode() !== "fullscreen") {
					buffer.removeAttribute("src");
					buffer.style.opacity = "0";
					buffer.style.zIndex = "";
					switching = false;
					sessionStorage.setItem(LAST_SWITCH_KEY, String(Date.now()));
					schedule();
					return false;
				}

				const fadeMs =
					document.documentElement.dataset.motionWallpaperCrossfade === "off" ||
					document.documentElement.dataset.reducedMotion === "true"
						? 0
						: crossfadeDuration;
				await nextPaint();
				buffer.style.transition = `opacity ${fadeMs}ms ease-in-out`;
				active.style.transition = `opacity ${fadeMs}ms ease-in-out`;
				buffer.style.opacity = "1";
				active.style.opacity = "0";

				await new Promise((resolve) =>
					window.setTimeout(resolve, fadeMs + 40),
				);
				if (destroyed || token !== jobToken) return false;
				active.removeAttribute("src");
				active.style.transition = "";
				buffer.style.transition = "";
				active.style.opacity = "1";
				active.style.zIndex = "";
				buffer.style.zIndex = "";
				group.dataset.wpActiveSlot = bufferSlot;
				sessionStorage.setItem(INDEX_KEY, String(next));
				sessionStorage.setItem(LAST_SWITCH_KEY, String(Date.now()));
				switching = false;
				schedule();
				return true;
			}

			window.__mizukiSwitchWallpaper = (force = true) =>
				void switchWallpaper(force, false);
			window.__fgmizukiWallpaperStatus = () => ({
				carouselEnabled,
				interval,
				hidden: document.hidden,
				reducedMotion: document.documentElement.dataset.reducedMotion,
				autoPlayPreference:
					document.documentElement.dataset.motionBannerAutoPlay,
				mode: mode(),
				canAutoplay: canAutoplay(),
				destroyed,
				switching,
				timerActive: timer !== null,
			});

			function syncGroup() {
				const group = getGroup();
				if (!group) return;
				activateInitial(group);
				schedule();
			}

			function syncMode() {
				if (mode() === "fullscreen") {
					activateInitial();
					schedule();
				} else {
					clearTimer();
				}
			}

			function onVisibility() {
				if (document.hidden) clearTimer();
				else schedule();
			}

			function destroy() {
				destroyed = true;
				jobToken += 1;
				clearTimer();
				window.removeEventListener("resize", syncGroup);
				window.removeEventListener("wallpaper-mode-change", syncMode);
				window.removeEventListener("fgmagi:settings-change", syncMode);
				document.removeEventListener("visibilitychange", onVisibility);
			}

			activateInitial();
			if (!readLastSwitch()) {
				sessionStorage.setItem(LAST_SWITCH_KEY, String(Date.now()));
			}
			if (media.addEventListener) media.addEventListener("change", syncGroup);
			window.addEventListener("resize", syncGroup);
			window.addEventListener("wallpaper-mode-change", syncMode);
			window.addEventListener("fgmagi:settings-change", syncMode);
			document.addEventListener("visibilitychange", onVisibility);
			window.addEventListener("pagehide", destroy, { once: true });
			schedule();
		})();
	</script>
</div>

<style>
	.wp-ken-burns {
		animation: wallpaper-ken-burns var(--wp-ken-burns-duration, 18s) ease-out alternate infinite;
		transform-origin: center;
		backface-visibility: hidden;
	}
	@keyframes wallpaper-ken-burns {
		from { transform: scale(1.01) translateZ(0); }
		to { transform: scale(1.045) translateZ(0); }
	}
	html[data-motion-wallpaper-ken-burns="off"] .wp-ken-burns {
		animation: none;
	}
	html[data-reduced-motion="true"] .wp-ken-burns {
		animation: none;
	}
</style>
