---
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import {
	loadAnimeData,
	type AnimeItem,
} from "../lib/content/anime-data";
// 直接 import 会被并进 Vite 的全局 CSS chunk，导致**每个页面**都下载这 4.7KB。
import animeStyleUrl from "../styles/anime.css?url";

if (!siteConfig.featurePages.anime) {
	return Astro.redirect("/404/");
}

const DEFAULT_ANIME_LAYOUT =
	siteConfig.anime?.defaultLayout === "compact" ? "compact" : "regular";
const BANGUMI_USER_ID = siteConfig.bangumi?.userId || "your-user-id";
const BILIBILI_VMID = siteConfig.bilibili?.vmid || "";
const ANIME_MODE = siteConfig.anime?.mode || "bangumi";
const ANIME_EMPTY = siteConfig.anime?.emptyMessages || {};

let animeList: AnimeItem[] = loadAnimeData(
	ANIME_MODE,
	import.meta.env.DEV,
);

function getStatusInfo(status: string) {
	switch (status) {
		case "watching":
			return {
				text: i18n(I18nKey.animeStatusWatching),
				class: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300",
				icon: "▶",
			};
		case "completed":
			return {
				text: i18n(I18nKey.animeStatusCompleted),
				class: "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300",
				icon: "✓",
			};
		case "planned":
			return {
				text: i18n(I18nKey.animeStatusPlanned),
				class: "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300",
				icon: "❤",
			};
		case "onhold":
			return {
				text: i18n(I18nKey.animeStatusOnHold),
				class: "bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300",
				icon: "⏸",
			};
		case "dropped":
			return {
				text: i18n(I18nKey.animeStatusDropped),
				class: "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300",
				icon: "✗",
			};
		default:
			return {
				text: status,
				class: "bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300",
				icon: "?",
			};
	}
}

const INITIAL_DISPLAY_COUNT = 24;
const visibleAnimeList = animeList.slice(0, INITIAL_DISPLAY_COUNT);
const hiddenAnimeList = animeList.slice(INITIAL_DISPLAY_COUNT);
---

<MainGridLayout
	title={i18n(I18nKey.anime)}
	description={i18n(I18nKey.animeSubtitle)}
>
	<link slot="head" rel="stylesheet" href={animeStyleUrl} />
	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-9 py-6 relative w-full" data-effect1-card data-filter-layout-container>
			<div class="relative w-full mb-8">
				<div class="mb-6">
					<h1
						class="text-4xl font-bold text-black/90 dark:text-white/90 mb-2 relative
                    before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
					>
						{i18n(I18nKey.animeTitle)}
					</h1>
					<p class="text-black/75 dark:text-white/75">
						{i18n(I18nKey.animeSubtitle)}
					</p>
				</div>

				<div class="mb-6">
					<div class="anime-filter-container">
						<div class="flex flex-wrap gap-2">
							<button
								class="anime-filter-tag anime-active"
								data-status="all"
								>{i18n(I18nKey.animeFilterAll)}</button
							>
							<button class="anime-filter-tag" data-status="watching"
								>{i18n(I18nKey.animeStatusWatching)}</button
							>
							<button class="anime-filter-tag" data-status="planned"
								>{i18n(I18nKey.animeStatusPlanned)}</button
							>
							<button class="anime-filter-tag" data-status="completed"
								>{i18n(I18nKey.animeStatusCompleted)}</button
							>
							{
								(ANIME_MODE === "bangumi" || ANIME_MODE === "bilibili") && (
									<>
										<button
											class="anime-filter-tag"
											data-status="onhold"
										>
											{i18n(I18nKey.animeStatusOnHold)}
										</button>
										<button
											class="anime-filter-tag"
											data-status="dropped"
										>
											{i18n(I18nKey.animeStatusDropped)}
										</button>
									</>
								)
							}
						</div>
						<div
							class="anime-layout-switch"
							role="group"
							aria-label={i18n(I18nKey.animeTitle)}
							data-layout={DEFAULT_ANIME_LAYOUT}
						>
							<span class="anime-layout-thumb" aria-hidden="true"></span>
							<button
								type="button"
								class="anime-layout-btn"
								data-layout="regular"
							>
								{i18n(I18nKey.animeLayoutRegular)}
							</button>
							<button
								type="button"
								class="anime-layout-btn"
								data-layout="compact"
							>
								{i18n(I18nKey.animeLayoutCompact)}
							</button>
						</div>
					</div>
				</div>
			</div>

			<div class="mb-8">
					{
						ANIME_MODE === "bilibili" &&
						(!BILIBILI_VMID || BILIBILI_VMID === "") ? (
							<div class="text-center py-12">
								<div class="text-5xl mb-4">😢</div>
								<h3 class="text-xl font-medium text-black/80 dark:text-white/80 mb-2">
									{i18n(I18nKey.animeEmpty)}
								</h3>
								<p class="text-black/60 dark:text-white/60">
									{ANIME_EMPTY.noBilibiliVmid ||
										"Please set your Bilibili vmid in the src/config.ts file"}
								</p>
							</div>
						) : ANIME_MODE !== "local" &&
							ANIME_MODE !== "bilibili" &&
							BANGUMI_USER_ID === "your-user-id" ? (
						<div class="text-center py-12">
							<div class="text-5xl mb-4">😢</div>
							<h3 class="text-xl font-medium text-black/80 dark:text-white/80 mb-2">
								{i18n(I18nKey.animeEmpty)}
							</h3>
							<p class="text-black/60 dark:text-white/60">
								{ANIME_EMPTY.noBangumiUserId ||
									"Please set your Bangumi userId in the src/config.ts file"}
							</p>
						</div>
					) : visibleAnimeList.length > 0 ? (
						<>
							<div
								id="anime-list-container"
								class={`anime-grid-container grid gap-4 md:gap-6 opacity-0 transition-opacity duration-300`}
							>
								{visibleAnimeList.map((anime) => {
									const statusInfo = getStatusInfo(
										anime.status,
									);
									const progressPercent =
										anime.totalEpisodes > 0
											? (anime.progress /
													anime.totalEpisodes) *
												100
											: 0;

									return (
										<div
											class="anime-card group relative bg-transparent rounded-xl border border-black/10 dark:border-white/10 overflow-hidden transition-shadow duration-300 hover:shadow-xl"
											data-effect1-card
											data-anime-status={anime.status}
										>
											<div class="relative anime-cover-container aspect-[2/3] overflow-hidden">
												<a
													href={anime.link}
													target="_blank"
													rel="noopener noreferrer"
													class="block w-full h-full"
												>
													<ImageWrapper
														src={anime.cover}
														alt={anime.title}
														class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-110"
													/>
													<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
														<div class="absolute inset-0 flex items-center justify-center">
															<div class="w-12 h-12 rounded-full bg-white/90 flex items-center justify-center">
																<svg
																	class="w-6 h-6 text-gray-800 ml-1"
																	fill="currentColor"
																	viewBox="0 0 24 24"
																>
																	<path d="M8 5v14l11-7z" />
																</svg>
															</div>
														</div>
													</div>
												</a>

												<div
													class={`absolute top-2 left-2 px-2 py-1 rounded-md text-xs font-medium ${statusInfo.class}`}
												>
													<span class="mr-1">
														{statusInfo.icon}
													</span>
													<span>
														{statusInfo.text}
													</span>
												</div>

												<div class="absolute top-2 right-2 bg-black/70 text-white px-2 py-1 rounded-md text-xs font-medium flex items-center gap-1">
													<svg
														class="w-3 h-3 text-yellow-400"
														fill="currentColor"
														viewBox="0 0 20 20"
													>
														<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
													</svg>
													<span>{anime.rating}</span>
												</div>

												{anime.status ===
													"watching" && (
													<div class="anime-progress absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-2">
														<div class="w-full bg-white/20 rounded-full h-1.5 mb-1">
															<div
																class="bg-gradient-to-r from-emerald-400 to-teal-400 h-1.5 rounded-full transition-all duration-300"
																style={`width: ${progressPercent}%`}
															/>
														</div>
														<div class="text-white text-xs font-medium">
															{anime.progress}/
															{
																anime.totalEpisodes
															}{" "}
															(
															{Math.round(
																progressPercent,
															)}
															%)
														</div>
													</div>
												)}
											</div>

											<div class="p-3">
												<h3 class="text-sm font-bold text-black/90 dark:text-white/90 mb-1 leading-tight">
													{anime.title}
												</h3>
												<p
													class="text-black/60 dark:text-white/60 text-xs mb-2 line-clamp-2"
													title={anime.description}
												>
													{anime.description}
												</p>

												<div class="space-y-1 text-xs">
													<div class="flex justify-between items-center">
														<span class="text-black/50 dark:text-white/50 shrink-0">
															{i18n(
																I18nKey.animeYear,
															)}
														</span>
														<span class="text-black/70 dark:text-white/70 truncate ml-2 text-right">
															{anime.year}
														</span>
													</div>
													<div class="flex justify-between items-start">
														<span class="text-black/50 dark:text-white/50 shrink-0 mt-0.5">
															{i18n(
																I18nKey.animeStudio,
															)}
														</span>
														<span
															class="text-black/70 dark:text-white/70 text-right ml-2 line-clamp-2 break-words"
															title={anime.studio}
														>
															{anime.studio}
														</span>
													</div>
													<div class="flex flex-wrap gap-1 mt-2">
														{anime.genre.map(
															(g) => (
																<span class="px-1.5 py-0.5 bg-[var(--btn-regular-bg)] text-black/70 dark:text-white/70 rounded text-xs">
																	{g}
																</span>
															),
														)}
													</div>
												</div>
											</div>
										</div>
									);
								})}
							</div>

							<template id="anime-lazy-store">
								{hiddenAnimeList.map((anime) => {
									const statusInfo = getStatusInfo(
										anime.status,
									);
									const progressPercent =
										anime.totalEpisodes > 0
											? (anime.progress /
													anime.totalEpisodes) *
												100
											: 0;

									return (
										<div
											class="anime-card group relative bg-transparent rounded-xl border border-black/10 dark:border-white/10 overflow-hidden transition-shadow duration-300 hover:shadow-xl"
											data-effect1-card
											data-anime-status={anime.status}
										>
											<div class="relative anime-cover-container aspect-[2/3] overflow-hidden">
												<a
													href={anime.link}
													target="_blank"
													rel="noopener noreferrer"
													class="block w-full h-full"
												>
													<ImageWrapper
														src={anime.cover}
														alt={anime.title}
														class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-110"
													/>
													<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
														<div class="absolute inset-0 flex items-center justify-center">
															<div class="w-12 h-12 rounded-full bg-white/90 flex items-center justify-center">
																<svg
																	class="w-6 h-6 text-gray-800 ml-1"
																	fill="currentColor"
																	viewBox="0 0 24 24"
																>
																	<path d="M8 5v14l11-7z" />
																</svg>
															</div>
														</div>
													</div>
												</a>

												<div
													class={`absolute top-2 left-2 px-2 py-1 rounded-md text-xs font-medium ${statusInfo.class}`}
												>
													<span class="mr-1">
														{statusInfo.icon}
													</span>
													<span>
														{statusInfo.text}
													</span>
												</div>

												<div class="absolute top-2 right-2 bg-black/70 text-white px-2 py-1 rounded-md text-xs font-medium flex items-center gap-1">
													<svg
														class="w-3 h-3 text-yellow-400"
														fill="currentColor"
														viewBox="0 0 20 20"
													>
														<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
													</svg>
													<span>{anime.rating}</span>
												</div>

												{anime.status ===
													"watching" && (
													<div class="anime-progress absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-2">
														<div class="w-full bg-white/20 rounded-full h-1.5 mb-1">
															<div
																class="bg-gradient-to-r from-emerald-400 to-teal-400 h-1.5 rounded-full transition-all duration-300"
																style={`width: ${progressPercent}%`}
															/>
														</div>
														<div class="text-white text-xs font-medium">
															{anime.progress}/
															{
																anime.totalEpisodes
															}{" "}
															(
															{Math.round(
																progressPercent,
															)}
															%)
														</div>
													</div>
												)}
											</div>

											<div class="p-3">
												<h3 class="text-sm font-bold text-black/90 dark:text-white/90 mb-1 leading-tight">
													{anime.title}
												</h3>
												<p
													class="text-black/60 dark:text-white/60 text-xs mb-2 line-clamp-2"
													title={anime.description}
												>
													{anime.description}
												</p>

												<div class="space-y-1 text-xs">
													<div class="flex justify-between items-center">
														<span class="text-black/50 dark:text-white/50 shrink-0">
															{i18n(
																I18nKey.animeYear,
															)}
														</span>
														<span class="text-black/70 dark:text-white/70 truncate ml-2 text-right">
															{anime.year}
														</span>
													</div>
													<div class="flex justify-between items-start">
														<span class="text-black/50 dark:text-white/50 shrink-0 mt-0.5">
															{i18n(
																I18nKey.animeStudio,
															)}
														</span>
														<span
															class="text-black/70 dark:text-white/70 text-right ml-2 line-clamp-2 break-words"
															title={anime.studio}
														>
															{anime.studio}
														</span>
													</div>
													<div class="flex flex-wrap gap-1 mt-2">
														{anime.genre.map(
															(g) => (
																<span class="px-1.5 py-0.5 bg-[var(--btn-regular-bg)] text-black/70 dark:text-white/70 rounded text-xs">
																	{g}
																</span>
															),
														)}
													</div>
												</div>
											</div>
										</div>
									);
								})}
							</template>

							{hiddenAnimeList.length > 0 && (
								<div
									id="infinite-scroll-sentinel"
									class="w-full h-20 flex items-center justify-center mt-8"
								>
									<div class="anime-loading-spinner w-8 h-8 border-4 border-[var(--primary)] border-t-transparent rounded-full animate-spin" />
								</div>
							)}
						</>
					) : (
						<div class="text-center py-12">
							<div class="text-5xl mb-4">😢</div>
							<h3 class="text-xl font-medium text-black/80 dark:text-white/80 mb-2">
								{i18n(I18nKey.animeEmpty)}
							</h3>
							<p class="text-black/60 dark:text-white/60">
								{ANIME_MODE === "local"
									? ANIME_EMPTY.localEmpty ||
										i18n(I18nKey.animeEmptyLocal)
									: ANIME_MODE === "bilibili"
										? ANIME_EMPTY.bilibiliEmpty ||
											"Bilibili数据为空，请运行 pnpm run update-bilibili 获取数据"
										: ANIME_EMPTY.bangumiEmpty ||
											i18n(I18nKey.animeEmptyBangumi)}
							</p>
						</div>
					)
				}
			</div>
		</div>
	</div>

	<script is:inline define:vars={{ defaultAnimeLayout: DEFAULT_ANIME_LAYOUT }}>
		(function () {
			const ANIME_LAYOUT_KEY = "animeLayoutMode";
			// 紧凑模式量测常量（与 anime.css 保持一致）：封面宽 移动 8.5rem / 桌面 11rem，列间距 1.5rem
			const COVER_WIDTH_MOBILE = 136;
			const COVER_WIDTH_DESKTOP = 176;
			const COLUMN_GAP = 24;
			const MOBILE_BREAKPOINT = 768;

			function getStoredLayout() {
				const stored = localStorage.getItem(ANIME_LAYOUT_KEY);
				if (stored === "regular" || stored === "compact") return stored;
				return defaultAnimeLayout === "compact" ? "compact" : "regular";
			}

			function initAnimeLayout() {
				const animeListContainer = document.getElementById(
					"anime-list-container",
				);
				if (!animeListContainer) return false;
				updateAnimeLayout(getStoredLayout(), false);
				requestAnimationFrame(() => {
					animeListContainer.classList.remove("opacity-0");
				});
				return true;
			}

			let retryCount = 0;
			const maxRetries = 10;
			function tryInit() {
				if (initAnimeLayout()) return;
				if (retryCount < maxRetries) {
					retryCount++;
					const delay = Math.min(
						100 * Math.pow(1.5, retryCount),
						1000,
					);
					setTimeout(tryInit, delay);
				} else {
					setTimeout(() => {
						const animeListContainer = document.getElementById(
							"anime-list-container",
						);
						if (animeListContainer) {
							updateAnimeLayout(getStoredLayout(), false);
							animeListContainer.classList.remove("opacity-0");
						}
					}, 2000);
				}
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", tryInit);
			} else {
				tryInit();
			}

			// 封面宽取首个可见封面的渲染宽度、列间距取容器计算样式 columnGap、容器宽取渲染宽度：
			// 三者均为实际渲染值，兼容 pageScaling 的 html 字号缩放与移动/桌面 gap 差异；实测不到时回退常量
			function computeCompactCols(animeListContainer) {
				const covers = Array.from(
					animeListContainer.querySelectorAll(
						".anime-cover-container",
					),
				).filter((item) => item.offsetParent !== null);

				let coverWidth = 0;
				if (covers.length > 0) {
					coverWidth = covers[0].getBoundingClientRect().width;
				}

				if (!(coverWidth > 0)) {
					coverWidth = window.matchMedia(
						`(min-width: ${MOBILE_BREAKPOINT}px)`,
					).matches
						? COVER_WIDTH_DESKTOP
						: COVER_WIDTH_MOBILE;
				}
				const computedGap = parseFloat(
					getComputedStyle(animeListContainer).columnGap,
				);
				const gap =
					Number.isFinite(computedGap) && computedGap > 0
						? computedGap
						: COLUMN_GAP;

				const containerWidth =
					animeListContainer.getBoundingClientRect().width;
				return Math.min(
					6,
					Math.max(
						2,
						Math.floor(
							(containerWidth + gap) / (coverWidth + gap),
						),
					),
				);
			}

			function applyCompactColumns(animeListContainer) {
				const cols = computeCompactCols(animeListContainer);
				animeListContainer.style.setProperty(
					"--anime-cols",
					String(cols),
				);
			}

			function updateCompactColumns() {
				const animeListContainer = document.getElementById(
					"anime-list-container",
				);
				if (
					!animeListContainer ||
					animeListContainer.dataset.currentLayout !== "compact"
				)
					return;
				applyCompactColumns(animeListContainer);
			}

			function updateLayoutSwitchButtons(layout) {
				const switchEl = document.querySelector(".anime-layout-switch");
				if (switchEl) switchEl.dataset.layout = layout;
				document.querySelectorAll(".anime-layout-btn").forEach((btn) => {
					const isActive =
						btn.getAttribute("data-layout") === layout;
					btn.classList.toggle("anime-active", isActive);
					btn.setAttribute("aria-pressed", String(isActive));
				});
			}

			function applyAnimeLayout(animeListContainer, nextLayout) {
				const style = document.createElement("style");
				style.innerHTML = `.anime-grid-container .group { transition: none !important; }`;
				document.head.appendChild(style);
				animeListContainer.classList.remove(
					"anime-list-mode",
					"anime-compact-mode",
				);
				animeListContainer.classList.remove(
					"grid-cols-1",
					"md:grid-cols-2",
					"lg:grid-cols-3",
				);
				animeListContainer.style.removeProperty("grid-template-columns");
				animeListContainer.style.removeProperty("--anime-cols");

				if (nextLayout === "compact") {
					animeListContainer.classList.add("anime-compact-mode");
					applyCompactColumns(animeListContainer);
				} else {
					animeListContainer.classList.add(
						"anime-list-mode",
						"grid-cols-1",
						"lg:grid-cols-2",
					);
				}

				void animeListContainer.offsetHeight;
				if (style.parentNode) style.parentNode.removeChild(style);
			}

			// shouldAnimate=false（首次打开/预渲染帧/切页进入）保持 08 语义：先应用布局与列数、容器维持 opacity-0，由 init 在 rAF 中统一移除 opacity-0 淡入
			let animeLayoutSwitching = false;
			function updateAnimeLayout(layout, shouldAnimate = true) {
				const animeListContainer = document.getElementById(
					"anime-list-container",
				);
				if (!animeListContainer) return;
				const nextLayout =
					layout === "compact" ? "compact" : "regular";

				if (!shouldAnimate) {
					animeListContainer.dataset.currentLayout = nextLayout;
					updateLayoutSwitchButtons(nextLayout);
					applyAnimeLayout(animeListContainer, nextLayout);
					return;
				}
				if (animeLayoutSwitching) return;
				if (animeListContainer.dataset.currentLayout === nextLayout) {
					updateLayoutSwitchButtons(nextLayout);
					return;
				}

				animeLayoutSwitching = true;
				animeListContainer.dataset.currentLayout = nextLayout;
				updateLayoutSwitchButtons(nextLayout);

				// 淡出 150ms：先强制回流确认当前 opacity=1，再置 0 触发过渡
				animeListContainer.style.transition = "opacity 150ms ease";
				void animeListContainer.offsetHeight;
				animeListContainer.style.opacity = "0";

				setTimeout(() => {
					applyAnimeLayout(animeListContainer, nextLayout);
					requestAnimationFrame(() => {
						animeListContainer.style.transition =
							"opacity 250ms ease";
						animeListContainer.style.opacity = "1";
						setTimeout(() => {
							animeListContainer.style.transition = "";
							animeListContainer.style.opacity = "";
							animeLayoutSwitching = false;
						}, 250);
					});
				}, 150);
			}

			function switchAnimeLayout(layout) {
				if (layout !== "regular" && layout !== "compact") return;
				const animeListContainer = document.getElementById(
					"anime-list-container",
				);
				const currentLayout = animeListContainer
					? animeListContainer.dataset.currentLayout
					: getStoredLayout();
				if (currentLayout === layout) return;
				localStorage.setItem(ANIME_LAYOUT_KEY, layout);
				window.dispatchEvent(
					new CustomEvent("animeLayoutChange", {
						detail: { layout },
					}),
				);
			}

			function setupLayoutSwitchButtons() {
				document.querySelectorAll(".anime-layout-btn").forEach((btn) => {
					btn.addEventListener("click", () => {
						switchAnimeLayout(btn.getAttribute("data-layout"));
					});
				});
				const thumb = document.querySelector(".anime-layout-thumb");
				if (thumb) {
					thumb.addEventListener("click", () => {
						const animeListContainer = document.getElementById(
							"anime-list-container",
						);
						const currentLayout = animeListContainer
							? animeListContainer.dataset.currentLayout
							: getStoredLayout();
						switchAnimeLayout(
							currentLayout === "compact" ? "regular" : "compact",
						);
					});
				}
			}
			setupLayoutSwitchButtons();

			if (!window.__animeLayoutBound) {
				window.__animeLayoutBound = true;
				window.addEventListener("animeLayoutChange", (event) => {
					const layout = event.detail && event.detail.layout;
					if (layout !== "regular" && layout !== "compact") return;
					updateAnimeLayout(layout);
				});
				window.addEventListener("resize", () => updateCompactColumns());
			}
		})();
	</script>

	<script is:inline>
		if (typeof window.animeFilterEventListeners === "undefined") {
			window.animeFilterEventListeners = [];
		}

		function initFilterButtons() {
			const filterTags = document.querySelectorAll(".anime-filter-tag");
			const sentinel = document.getElementById(
				"infinite-scroll-sentinel",
			);
			const listContainer = document.getElementById(
				"anime-list-container",
			);
			const lazyStore = document.getElementById("anime-lazy-store");
			window.animeFilterEventListeners.forEach((listener) => {
				const [element, type, handler] = listener;
				element.removeEventListener(type, handler);
			});
			window.animeFilterEventListeners = [];
			const allFilter = Array.from(filterTags).find(
				(tag) => tag.getAttribute("data-status") === "all",
			);

			filterTags.forEach((tag) => {
				const clickHandler = function () {
					const isAll =
						this.getAttribute("data-status") === "all";
					const target =
						!isAll && this.classList.contains("anime-active")
							? allFilter || this
							: this;

					filterTags.forEach((t) =>
						t.classList.remove("anime-active"),
					);
					target.classList.add("anime-active");

					if (
						lazyStore &&
						lazyStore.content.children.length > 0 &&
						listContainer
					) {
						const fragment = document.createDocumentFragment();
						while (lazyStore.content.firstChild) {
							const node = lazyStore.content.firstChild;
							fragment.appendChild(node);
						}
						listContainer.appendChild(fragment);
					}

					if (sentinel) sentinel.style.display = "none";
					const initialHidden =
						listContainer.querySelectorAll(".initial-hidden");
					initialHidden.forEach((el) => {
						el.classList.remove("hidden", "initial-hidden");
					});

					const status = target.getAttribute("data-status");
					const animeItems = Array.from(
						listContainer.children,
					).filter((item) => item.hasAttribute("data-anime-status"));
					const desired = new Map();
					animeItems.forEach((item) => {
						const itemStatus =
							item.getAttribute("data-anime-status");
						desired.set(
							item,
							status === "all" || itemStatus === status,
						);
					});
					if (window.CardFilter) {
						window.CardFilter.applyGroup(
							animeItems,
							(item) => desired.get(item) === true,
							{
								group: listContainer,
								layoutContainer:
									listContainer.closest(
										"[data-filter-layout-container]",
									),
								animateLayoutHeight: true,
							},
						);
					} else {
						animeItems.forEach((item) => {
							item.style.display = desired.get(item)
								? ""
								: "none";
						});
					}
				};

				tag.addEventListener("click", clickHandler);
				window.animeFilterEventListeners.push([
					tag,
					"click",
					clickHandler,
				]);
			});
			if (sentinel && lazyStore && listContainer) {
				const observer = new IntersectionObserver(
					(entries) => {
						if (entries[0].isIntersecting) {
							const BATCH_SIZE = 24;
							if (lazyStore.content.children.length === 0) {
								sentinel.style.display = "none";
								observer.disconnect();
								return;
							}

							const fragment = document.createDocumentFragment();
							let movedCount = 0;
							while (
								lazyStore.content.firstChild &&
								movedCount < BATCH_SIZE
							) {
								const node = lazyStore.content.firstChild;
								fragment.appendChild(node);
								movedCount++;
							}

							requestAnimationFrame(() => {
								listContainer.appendChild(fragment);
								if (lazyStore.content.children.length === 0) {
									sentinel.style.display = "none";
									observer.disconnect();
								}
							});
						}
					},
					{ rootMargin: "200px" },
				);
				observer.observe(sentinel);
			} else if (sentinel) {
				sentinel.style.display = "none";
			}
		}

		document.addEventListener("DOMContentLoaded", initFilterButtons);
		function setupSwupListeners() {
			if (window.swup) {
				window.swup.hooks.on("content:replace", () =>
					setTimeout(initFilterButtons, 150),
				);
				window.swup.hooks.on("page:view", () =>
					setTimeout(initFilterButtons, 150),
				);
			}
		}

		if (typeof window !== "undefined") {
			if (window.swup) {
				setupSwupListeners();
			} else {
				document.addEventListener("swup:enable", setupSwupListeners);
			}
		}
	</script>
</MainGridLayout>
