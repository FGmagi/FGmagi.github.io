---
export interface Props {
	text: string | string[];
	speed?: number;
	deleteSpeed?: number;
	pauseTime?: number;
	class?: string;
}

const {
	text,
	speed = 100,
	deleteSpeed = 50,
	pauseTime = 2000,
	class: className = "",
} = Astro.props;
const textData = Array.isArray(text) ? JSON.stringify(text) : text;
---

<span class={`typewriter ${className}`} data-text={textData} data-speed={speed} data-delete-speed={deleteSpeed} data-pause-time={pauseTime}></span>

<script>
// 旧实现的三处问题：
//   1. DOMContentLoaded 与 swup 换页各 new 一个实例、旧实例从不 destroy ——
//      横幅副标题这类「不被 swup 替换」的元素会被多个定时器同时写 textContent
//      （表现为文字跳动/闪烁），切页越多实例越多；
//   2. 每 50~100ms 一次 textContent 写入，后台标签页也照跑；
//   3. 完全忽略 prefers-reduced-motion。
// 现在：模块级 WeakMap 单实例 + 页面隐藏时暂停 + 减少动效时直出全文。
import { prefersReducedMotion } from "../utils/motion-preference";

interface TypewriterInstance {
	destroy(): void;
}

/** 每个元素只保留一个实例（弱引用，元素被 swup 换掉后自然回收） */
const instances = new WeakMap<HTMLElement, TypewriterInstance>();

class TypewriterEffect implements TypewriterInstance {
	private element: HTMLElement;
	private texts: string[];
	private speed: number;
	private deleteSpeed: number;
	private pauseTime: number;
	private currentTextIndex = 0;
	private currentIndex = 0;
	private isDeleting = false;
	private timerId: number | null = null;
	private disposed = false;
	private readonly onVisibilityChange = () => {
		if (document.hidden) {
			this.clearTimer();
		} else if (!this.disposed) {
			this.schedule(this.speed);
		}
	};

	constructor(element: HTMLElement) {
		this.element = element;
		const raw = element.dataset.text || "";
		try {
			const parsed = JSON.parse(raw);
			this.texts = Array.isArray(parsed) ? parsed : [raw];
		} catch {
			this.texts = [raw];
		}

		this.speed = Number.parseInt(element.dataset.speed || "100", 10) || 100;
		this.deleteSpeed =
			Number.parseInt(element.dataset.deleteSpeed || "50", 10) || 50;
		this.pauseTime =
			Number.parseInt(element.dataset.pauseTime || "2000", 10) || 2000;

		// A disabled feature or system reduced-motion preference shows the first
		// subtitle immediately and creates no timer.
		if (
			document.documentElement.dataset.motionTypewriter === "off" ||
			prefersReducedMotion() ||
			(element.closest("#banner-wrapper") &&
				(localStorage.getItem("wallpaperMode") || "banner") !== "banner") ||
			this.texts.length === 0
		) {
			this.element.textContent = this.texts[0] ?? "";
			return;
		}

		document.addEventListener("visibilitychange", this.onVisibilityChange);
		this.step();
	}

	private clearTimer() {
		if (this.timerId !== null) {
			window.clearTimeout(this.timerId);
			this.timerId = null;
		}
	}

	private schedule(delay: number) {
		this.clearTimer();
		if (this.disposed || document.hidden) return;
		this.timerId = window.setTimeout(() => this.step(), delay);
	}

	private step() {
		if (this.disposed) return;
		const currentText = this.texts[this.currentTextIndex] || "";

		if (this.isDeleting) {
			if (this.currentIndex > 0) {
				this.currentIndex -= 1;
				this.element.textContent = currentText.substring(0, this.currentIndex);
				this.schedule(this.deleteSpeed);
				return;
			}
			this.isDeleting = false;
			this.currentTextIndex = (this.currentTextIndex + 1) % this.texts.length;
			this.schedule(this.speed);
			return;
		}

		if (this.currentIndex < currentText.length) {
			this.currentIndex += 1;
			this.element.textContent = currentText.substring(0, this.currentIndex);
			this.schedule(this.speed);
			return;
		}

		// 只有一条文本时保持显示，不删除
		if (this.texts.length > 1) {
			this.isDeleting = true;
			this.schedule(this.pauseTime);
		} else if (currentText === "") {
			this.element.innerHTML = "&nbsp;";
		}
	}

	public destroy() {
		this.disposed = true;
		this.clearTimer();
		document.removeEventListener("visibilitychange", this.onVisibilityChange);
	}
}

function mountTypewriters() {
	const elements = document.querySelectorAll<HTMLElement>(".typewriter");
	elements.forEach((element) => {
		// 先销毁旧实例，避免同一元素被多个定时器轮流写
		instances.get(element)?.destroy();
		instances.set(element, new TypewriterEffect(element));
	});
}

if (document.readyState === "loading") {
	document.addEventListener("DOMContentLoaded", mountTypewriters, { once: true });
} else {
	mountTypewriters();
}

// swup 换页后重新挂载（新节点）；事件名两种都监听，任一先到都只做一次幂等重挂
document.addEventListener("swup:page:view", mountTypewriters);
document.addEventListener("swup:contentReplaced", mountTypewriters);
window.addEventListener("fgmagi:settings-change", mountTypewriters);
window.addEventListener("wallpaper-mode-change", mountTypewriters);
</script>

<style>
.typewriter {
    position: relative;
    min-height: 1.5em; /* 确保即使没有文字也保持最小高度 */
    display: inline-block;
    vertical-align: baseline;
}

/* 确保打字机效果不会导致布局抖动 */
.typewriter:empty::before {
    content: '\00A0'; /* 使用不间断空格保持高度 */
    visibility: hidden;
}
</style>
